---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/ui/Hero.astro';
import Section from '../components/ui/Section.astro';
import Button from '../components/ui/Button.astro';
import CtaSplit from '../components/ui/CtaSplit.astro';
import FeatureShowcase from '../components/ui/FeatureShowcase.astro';
import RelatedSection from '../components/ui/RelatedSection.astro';
import RelatedCard from '../components/ui/RelatedCard.astro';
import ContentRows from '../components/ui/ContentRows.astro';
import ContentRow from '../components/ui/ContentRow.astro';

const PROVA_URL =
  'https://automazione.n8ndevelop.it/form/8ce36c5e-0cc4-4813-9a0f-2da2a7605fb0?source=SitoWeb&medium=Btn_Home';
const ABBONAMENTI_URL = 'https://passion.perfectgym.com/clientportal2/#/Registration';

const QUICKLINKS = [
  {
    title: 'Planning',
    body: "Oltre 250 lezioni al mese tra Rebalance, Energy, Pilates e Reformer, distribuite su più sale e studi dedicati. Consulta gli orari aggiornati in tempo reale e organizza la tua settimana di allenamento in pochi secondi.",
    href: '/orari-corsi/',
    cta: 'Scopri il planning',
    icon: 'calendar',
    image: '/images/uploads/2025/01/corso-di-step-min-1168x600-1.jpg',
  },
  {
    title: 'Abbonamenti',
    body: 'Dalla sala pesi in accesso libero ai pacchetti di Personal Training, fino alle formule Open pensate per chi si allena senza vincoli di orario. Scegli la soluzione più adatta al tuo obiettivo e al tuo budget.',
    href: ABBONAMENTI_URL,
    cta: 'Scopri gli abbonamenti',
    icon: 'dumbbell',
    image: '/images/uploads/2024/10/Palestra-11920x.jpg',
  },
  {
    title: 'Prova Open',
    body: "Vieni a scoprire di persona sala pesi, corsi fitness e studi Reformer con un accesso gratuito e senza impegno. Il nostro staff ti guida nella scelta del percorso più adatto a te fin dal primo allenamento.",
    href: PROVA_URL,
    cta: 'Prova ora',
    icon: 'heart-arm',
    image: '/images/uploads/2024/11/MRZ01857-scaled.jpeg',
  },
];

const QUICKLINK_ICONS = {
  calendar:
    '<svg viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="9" y="8" width="30" height="34" rx="3"/><rect x="17" y="4" width="14" height="8" rx="2"/><line x1="15" y1="21" x2="33" y2="21"/><line x1="15" y1="28" x2="33" y2="28"/><line x1="15" y1="35" x2="25" y2="35"/></svg>',
  dumbbell:
    '<svg viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="10" cy="20" r="5"/><circle cx="15" cy="28" r="4"/><line x1="15" y1="24" x2="31" y2="12"/><circle cx="35" cy="16" r="4"/><circle cx="40" cy="22" r="3"/></svg>',
  'heart-arm':
    '<svg viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M8 36c0-11 6-21 17-23-2 6 0 11 6 11"/><path d="M29 11c2-3 6-3 8 0 2-3 6-3 8 0 0 4-4 8-8 10-4-2-8-6-8-10Z"/></svg>',
};

const latestPosts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf())
  .slice(0, 3);
---

<BaseLayout
  title="Passion Fitness | Palestre Roma"
  description="Passion Fitness | Palestre Roma | Passion Fitness Tuscolana"
>
  <Hero
    title="PASSION FITNESS"
    video="/videos/hero-provvisorio.mp4"
    image="/images/uploads/2024/11/MRZ08075.jpeg"
    soft
  >
    <p>La palestra più grande delle zone Tuscolana, Cinecittà, Don Bosco e San Policarpo.<br />Un luogo dove persone diverse, con obiettivi unici, trovano il proprio percorso ideale per sentirsi meglio, insieme.</p>
    <div class="hero-ctas">
      <Button href={PROVA_URL} variant="white">Prova Passion Fitness</Button>
    </div>
  </Hero>

  <section class="quicklinks-section">
    <div class="quicklinks">
      {QUICKLINKS.map((item) => (
        <article class="quicklinks__card">
          <div class="quicklinks__bg" style={`background-image: url(${item.image})`}></div>
          <div class="quicklinks__overlay"></div>
          <div class="quicklinks__content">
            <div class="quicklinks__icon" set:html={QUICKLINK_ICONS[item.icon]} />
            <h3>{item.title}</h3>
            <p class="quicklinks__body">{item.body}</p>
            <a class="quicklinks__cta" href={item.href}>
              {item.cta}
              <span aria-hidden="true">→</span>
            </a>
          </div>
        </article>
      ))}
    </div>
  </section>

  <Section tone="dark">
    <div class="stats">
      <div class="stat">
        <span class="stat__num">30+</span>
        <span class="stat__label">Anni nel settore</span>
      </div>
      <div class="stat">
        <span class="stat__num">2000</span>
        <span class="stat__label">m² dedicati al fitness</span>
      </div>
      <div class="stat">
        <span class="stat__num">1000</span>
        <span class="stat__label">mq di sala pesi</span>
      </div>
      <div class="stat">
        <span class="stat__num">2+2</span>
        <span class="stat__label">Sale fitness e studi reformer</span>
      </div>
    </div>
  </Section>

  <div class="programmi-band">
    <ContentRows>
      <ContentRow
        title="Sala Pesi"
        video="/videos/2024/11/Sala-Pesi_Passion-Fitness.mp4"
        alt="Sala pesi Passion Fitness"
      >
        <p>Oltre 95 postazioni con <strong>macchinari Technogym e Panatta di ultima generazione</strong>, pensati per il massimo coinvolgimento muscolare e un allenamento sempre all'avanguardia.</p>
        <p>Aperti <strong>tutti i giorni dalle 5:00 alle 24:00</strong>, anche a Natale e Ferragosto: zona free weight, area calisthenics e area booty training per ogni tipo di allenamento.</p>
        <Button href="/palestra/sala-pesi/" variant="white">Vai alla Sala Pesi</Button>
      </ContentRow>

      <ContentRow
        title="Corsi Fitness"
        video="/videos/2025/02/Metcon-2.mp4"
        alt="Corsi fitness Passion Fitness"
      >
        <p><strong>2 sale dedicate</strong>, corsi dalle 7:00 alle 21:30: oltre 120 ore mensili di lezioni <strong>Rebalance</strong> (Pilates, Pilates Barre, Posturale, Yoga) per lavorare su mobilità e postura.</p>
        <p>A queste si aggiungono oltre 130 ore di lezioni <strong>Energy</strong> (Pump, Met-Con, Prepugilistica, Funzionale, Booty Pump), per chi cerca un allenamento più intenso e dinamico.</p>
        <Button href="/palestra/corsi-fitness/" variant="white">Vai ai Corsi Fitness</Button>
      </ContentRow>

      <ContentRow
        title="I Love My Trainer"
        video="/videos/2024/11/I-love-my-trainer-2.mp4"
        alt="Personal training Passion Fitness"
      >
        <p>Con la formula <strong>I Love My Trainer</strong> acquisti lezioni individuali con uno dei nostri Personal Trainer, ricevendo in omaggio l'abbonamento in palestra.</p>
        <p>Un percorso su misura, a partire da <strong>65€/mese</strong>, pensato per chi vuole risultati concreti con la massima attenzione e personalizzazione.</p>
        <Button href="/i-love-my-trainer/" variant="white">Vai al Personal Training</Button>
      </ContentRow>

      <ContentRow
        title="Reformer"
        video="/videos/2024/10/reformer_senza_testi.mp4"
        alt="Pilates Reformer Passion Fitness"
      >
        <p><strong>3 sale interamente dedicate al Reformer</strong>: Studio Reformer per chi inizia, Studio Reformer Plus per livelli intermedi e avanzati.</p>
        <p>Studio PT Reformer per lezioni individuali con <strong>Reformer, Cadillac e Chair</strong>: la prima lezione è gratuita, paghi solo 10€ di assicurazione.</p>
        <Button href="/pilates-reformer/" variant="white">Vai al Reformer</Button>
      </ContentRow>
    </ContentRows>
  </div>

  <FeatureShowcase
    title="Perché scegliere noi?"
    images={[
      { src: '/images/uploads/2024/11/MRZ08075.jpeg', alt: 'Passion Fitness Tuscolana' },
      { src: '/images/uploads/2024/11/Sala-Pesi-1.jpeg', alt: 'Sala pesi Passion Fitness' },
      { src: '/images/uploads/2024/10/sale_fitness.jpg', alt: 'Sala corsi fitness' },
      { src: '/images/uploads/2024/11/reform_1-1.jpeg', alt: 'Studio Pilates Reformer' },
      { src: '/images/uploads/2024/10/Palestra-11920x.jpg', alt: 'Palestra Passion Fitness' },
      { src: '/images/uploads/2024/11/MRZ08109.jpeg', alt: 'Personal training Passion Fitness' },
    ]}
    features={[
      '30+ anni di esperienza nel settore',
      "La persona sempre al centro, prima dell'allenamento",
      "Tutta l'attenzione che meriti, ad ogni allenamento",
      'Ti alleniamo al tuo fianco, finché non acquisirai piena sicurezza',
    ]}
  >
    <CtaSplit
      slot="cta"
      heading="Pronto a iniziare?"
      text="Il primo allenamento è gratuito e senza impegno: vieni a scoprire Passion Fitness."
      buttonLabel="Prova Passion Fitness"
      buttonHref={PROVA_URL}
      image="/images/uploads/2024/11/MRZ08075.jpeg"
      alt="Passion Fitness Tuscolana"
    />
  </FeatureShowcase>

  <RelatedSection title="Leggi il nostro Blog">
    {latestPosts.map((post) => (
      <RelatedCard
        title={post.data.title}
        href={`/${post.data.slug}/`}
        image={post.data.coverImage}
        alt={post.data.title}
      />
    ))}
  </RelatedSection>
</BaseLayout>

<style>
  .hero-ctas {
    display: flex;
    gap: var(--space-xs);
    flex-wrap: wrap;
    margin-top: var(--space-2xs);
  }
  /* CTA unica della hero: piu' grande del bottone standard e con uno zoom
     in hover al posto del piccolo scatto verticale, piu' lento cosi' il
     movimento si legge. `a.button` per stare sopra la regola del
     componente Button senza ricorrere a !important. */
  .hero-ctas :global(a.button) {
    font-size: clamp(1rem, 1.15vw, 1.2rem);
    padding: 1.1rem 2.2rem;
    transition: transform 0.35s cubic-bezier(0.22, 0.61, 0.36, 1),
      background-color 0.25s ease, color 0.25s ease, border-color 0.25s ease;
  }
  .hero-ctas :global(a.button:hover) {
    transform: scale(1.06);
  }
  /* Anche la freccia rallenta, altrimenti scatta mentre il bottone scala. */
  .hero-ctas :global(a.button:hover) :global(.button__arrow) {
    transform: translateX(5px);
    transition: transform 0.35s cubic-bezier(0.22, 0.61, 0.36, 1);
  }
  /* Solo sulla home: il logo nell'header gia' mostra il brand, quindi su
     mobile il titolo "Passion Fitness" nell'hero e' ridondante e va nascosto.
     Le altre pagine che usano Hero con video (PageLayout) non hanno questa
     ridondanza e devono invece mostrare il titolo. */
  @media (max-width: 860px) {
    :global(.hero:has(.hero-media) .hero-title-group) {
      display: none;
    }
  }

  .quicklinks-section {
    /* dvh come l'hero: con vh la fascia sfora oltre lo schermo reale
       quando la barra degli indirizzi del browser mobile e' visibile. */
    height: 50vh;
    height: 50dvh;
    border-top: 2px solid var(--color-black);
  }
  .quicklinks {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    height: 100%;
  }
  .quicklinks__card {
    position: relative;
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .quicklinks__card:not(:first-child) {
    border-left: 2px solid var(--color-black);
  }
  .quicklinks__bg {
    position: absolute;
    inset: 0;
    background-size: cover;
    background-position: center;
  }
  .quicklinks__overlay {
    position: absolute;
    inset: 0;
    background: rgba(0, 0, 0, 0.6);
    transition: background-color 0.3s ease;
  }
  .quicklinks__card:hover .quicklinks__overlay {
    background: var(--accent);
  }
  .quicklinks__content {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: var(--space-2xs);
    padding: var(--space-lg) var(--space-md);
    max-width: 26rem;
  }
  /* Il box e' meta' altezza di prima: niente piu' spazio per l'icona,
     tolta del tutto invece di continuare a riservarle un posto vuoto. */
  .quicklinks__icon {
    display: none;
  }
  .quicklinks__content h3 {
    color: var(--color-white);
    font-size: clamp(1.8rem, 3vw, 2.4rem);
  }
  .quicklinks__body {
    color: var(--text-on-dark-muted);
    font-size: 0.95rem;
    line-height: 1.5;
    opacity: 0;
    max-height: 0;
    margin: 0;
    overflow: hidden;
    transition: opacity 0.25s ease, max-height 0.25s ease, margin-block 0.25s ease, color 0.25s ease;
  }
  .quicklinks__card:hover .quicklinks__body {
    opacity: 1;
    max-height: 12rem;
    margin-block: var(--space-2xs);
    color: var(--color-white);
  }
  /* Solo scritta, nessun box: sottolineato bianco con freccia, come gli
     altri link testuali del sito ma senza il rosso (qui e' gia' su fondo
     rosso in hover). */
  .quicklinks__cta {
    display: inline-flex;
    align-items: center;
    gap: 0.4em;
    width: fit-content;
    margin-top: var(--space-sm);
    color: var(--color-white);
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }
  .quicklinks__cta span {
    transition: transform 0.15s ease;
  }
  .quicklinks__cta:hover span {
    transform: translateX(3px);
  }
  .quicklinks__link {
    display: inline-block;
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--color-red);
  }
  @media (max-width: 760px) {
    .quicklinks-section {
      height: auto;
    }
    .quicklinks {
      grid-template-columns: 1fr;
    }
    .quicklinks__card {
      /* Meta' di prima, come la versione desktop. */
      min-height: 12rem;
      border-left: none;
    }
    .quicklinks__card:not(:first-child) {
      border-left: none;
      border-top: 2px solid var(--color-black);
    }
    /* Niente hover su touch: il paragrafo (che altrove si rivela solo al
       passaggio del mouse) qui resta sempre visibile, gia' nel colore
       bianco della versione "in hover" di desktop. */
    .quicklinks__body {
      opacity: 1;
      max-height: none;
      margin-block: var(--space-2xs);
      color: var(--color-white);
    }
  }

  /* Regole solo-desktop specifiche della home. Il comportamento mobile
     vive nei componenti (ContentRow, FeatureShowcase, CtaSplit,
     RelatedCard), cosi' e' identico su tutte le pagine. */
  .programmi-band {
    background: var(--bg-light-soft);
  }
  /* Il lato testo forma un blocco uguale e opposto a quello del video: il
     lato attaccato al video perde il proprio bordo (il video ha gia' il
     suo su quel confine), altrimenti si legge una linea doppia. */
  .programmi-band :global(.content-row__copy) {
    border: 2px solid var(--color-black);
  }
  .programmi-band :global(.content-row:nth-child(odd) .content-row__copy) {
    border-left: none;
  }
  .programmi-band :global(.content-row:nth-child(even) .content-row__copy) {
    border-right: none;
  }
  /* Il pulsante non deve leggersi come un box dentro il box del testo:
     nessuno sfondo, nessun bordo, solo scritta e freccia. */
  .programmi-band :global(.content-row__copy .button),
  .programmi-band :global(.content-row__copy .button:hover) {
    background: transparent;
    color: var(--text-on-light);
    border-color: transparent;
    padding-inline: 0;
  }
  /* Su mobile .content-row__copy diventa display:contents (vedi
     ContentRow): senza box non ha bordi da mostrare, quindi le regole qui
     sopra si disattivano da sole. */

  /* Solo qui la fascia rossa di chiusura e' alta come una riga video+testo
     invece di una schermata intera, e ha un bordo tra le due meta'. Le
     altre pagine tengono il 100vh di default del componente. Limitato al
     desktop: su mobile la fascia si dimensiona sul testo (vedi CtaSplit). */
  @media (min-width: 861px) {
    /* Tre classi: la regola `height:100vh` del componente CtaSplit ne ha
       due (classe + attributo di scope) e a parita' vincerebbe in base al
       solo ordine di caricamento dei file CSS. */
    :global(.showcase .showcase__cta .cta-split) {
      height: auto;
      min-height: 30rem;
    }
    :global(.showcase .showcase__cta .cta-split__copy) {
      border-right: 2px solid var(--color-black);
    }
  }

  .stats {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(11rem, 1fr));
    gap: var(--space-md);
  }
  @media (max-width: 860px) {
    .stats {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  .stat {
    display: flex;
    flex-direction: column;
    gap: var(--space-3xs);
  }
  .stat__num {
    font-family: var(--font-display);
    color: var(--color-red);
    font-size: clamp(2.2rem, 4vw, 3rem);
    line-height: 1;
    font-variant-numeric: tabular-nums;
  }
  .stat__label {
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    opacity: 0.9;
  }

</style>
