---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/ui/Hero.astro';
import Section from '../components/ui/Section.astro';
import Button from '../components/ui/Button.astro';
import CtaSplit from '../components/ui/CtaSplit.astro';
import FeatureShowcase from '../components/ui/FeatureShowcase.astro';
import RelatedSection from '../components/ui/RelatedSection.astro';
import RelatedCard from '../components/ui/RelatedCard.astro';

const PROVA_URL =
  'https://automazione.n8ndevelop.it/form/8ce36c5e-0cc4-4813-9a0f-2da2a7605fb0?source=SitoWeb&medium=Btn_Home';
const ABBONAMENTI_URL = 'https://passion.perfectgym.com/clientportal2/#/Registration';

const QUICKLINKS = [
  {
    title: 'Planning',
    body: "Oltre 250 lezioni al mese tra Rebalance, Energy, Pilates e Reformer, distribuite su più sale e studi dedicati. Consulta gli orari aggiornati in tempo reale e organizza la tua settimana di allenamento in pochi secondi.",
    href: '/orari-corsi/',
    cta: 'Scopri il planning',
    icon: 'calendar',
    image: '/images/uploads/2025/01/corso-di-step-min-1168x600-1.jpg',
  },
  {
    title: 'Abbonamenti',
    body: 'Dalla sala pesi in accesso libero ai pacchetti di Personal Training, fino alle formule Open pensate per chi si allena senza vincoli di orario. Scegli la soluzione più adatta al tuo obiettivo e al tuo budget.',
    href: ABBONAMENTI_URL,
    cta: 'Scopri gli abbonamenti',
    icon: 'dumbbell',
    image: '/images/uploads/2024/10/Palestra-11920x.jpg',
  },
  {
    title: 'Prova Open',
    body: "Vieni a scoprire di persona sala pesi, corsi fitness e studi Reformer con un accesso gratuito e senza impegno. Il nostro staff ti guida nella scelta del percorso più adatto a te fin dal primo allenamento.",
    href: PROVA_URL,
    cta: 'Prova ora',
    icon: 'heart-arm',
    image: '/images/uploads/2024/11/MRZ01857-scaled.jpeg',
  },
];

const QUICKLINK_ICONS = {
  calendar:
    '<svg viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="9" y="8" width="30" height="34" rx="3"/><rect x="17" y="4" width="14" height="8" rx="2"/><line x1="15" y1="21" x2="33" y2="21"/><line x1="15" y1="28" x2="33" y2="28"/><line x1="15" y1="35" x2="25" y2="35"/></svg>',
  dumbbell:
    '<svg viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="10" cy="20" r="5"/><circle cx="15" cy="28" r="4"/><line x1="15" y1="24" x2="31" y2="12"/><circle cx="35" cy="16" r="4"/><circle cx="40" cy="22" r="3"/></svg>',
  'heart-arm':
    '<svg viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M8 36c0-11 6-21 17-23-2 6 0 11 6 11"/><path d="M29 11c2-3 6-3 8 0 2-3 6-3 8 0 0 4-4 8-8 10-4-2-8-6-8-10Z"/></svg>',
};

const PROGRAMMI = [
  {
    id: 'sala-pesi',
    title: 'Sala Pesi',
    kicker: '1000 mq di sala pesi attrezzata',
    body: "Passion Fitness è costantemente aggiornata sulle ultime innovazioni nel mondo delle attrezzature per il massimo coinvolgimento muscolare. Macchinari Technogym e Panatta di ultima generazione, progettati per un allenamento all'avanguardia.",
    video: '/videos/2024/11/Sala-Pesi_Passion-Fitness.mp4',
    href: '/palestra/sala-pesi/',
    cta: 'Vai alla Sala Pesi',
  },
  {
    id: 'corsi-fitness',
    title: 'Corsi Fitness',
    kicker: "Le sale più grandi della Tuscolana",
    body: '2 sale dedicate, corsi dalle 7:00 alle 21:30: +120h di lezioni Rebalance (Pilates, Pilates Barre, Posturale, Yoga) e +130h di lezioni Energy (Pump, Met-Con, Prepugilistica, Funzionale, Booty Pump).',
    video: '/videos/2025/02/Metcon-2.mp4',
    href: '/palestra/corsi-fitness/',
    cta: 'Vai ai Corsi Fitness',
  },
  {
    id: 'i-love-my-trainer',
    title: 'I Love My Trainer',
    kicker: 'Un personal trainer per i tuoi obiettivi',
    body: "Con la formula I Love My Trainer, acquistando lezioni individuali con uno dei nostri PT, avrai in omaggio l'abbonamento in palestra. A partire da 65€/mese.",
    video: '/videos/2024/11/I-love-my-trainer-2.mp4',
    href: '/i-love-my-trainer/',
    cta: 'Vai al Personal Training',
  },
  {
    id: 'pilates-reformer',
    title: 'Reformer',
    kicker: "Vivi l'esperienza reformer",
    body: 'Studio Reformer per costruire basi solide, Studio Reformer+ per classi intermedie e avanzate, Studio Reformer Individuale per un percorso su misura con un trainer dedicato.',
    video: '/videos/2024/10/reformer_senza_testi.mp4',
    href: '/pilates-reformer/',
    cta: 'Vai al Reformer',
  },
];

const FAQ = [
  {
    q: 'Quali sono gli orari di apertura della palestra?',
    a: 'Passion Fitness Tuscolana è aperta tutti i giorni, dalle 5 alle 24.',
  },
  {
    q: 'Verrò seguito/a dai personal trainer in sala pesi?',
    a: "Di più! Con la formula I Love My Trainer acquisti direttamente le lezioni individuali, a partire da 65€/mese, con un Personal Trainer che si dedicherà unicamente a te.",
  },
  {
    q: 'Posso acquistare online gli abbonamenti?',
    a: 'Sì, accedendo alla sezione degli abbonamenti online puoi iscriverti scegliendo la tipologia di abbonamento desiderato.',
  },
];

const TESTIMONIANZE = [
  {
    quote:
      'Ho frequentato questa palestra per sei mesi con un personal trainer e mi sono trovata molto bene. Ho partecipato anche ai corsi organizzati durante la settimana, in particolare Pilates Barre con Luca, e sono rimasta molto soddisfatta.',
    author: 'Elnaz Yousefi',
  },
  {
    quote:
      "Dopo svariate esperienze in altre palestre l'unica cosa che mi era rimasta era la frustrazione di non aver ottenuto risultati. Ho dovuto ricredermi: sono stata ascoltata e guidata verso i miei obiettivi, oggi sono seguita a 360 gradi da tutto il personale.",
    author: 'Francesca Amadei',
  },
  {
    quote:
      'Soluzioni di allenamento variegate, dal classico abbonamento in sala pesi a lezioni di Pilates, yoga, metabolico. Presente anche il Pilates Reformer per completare un allenamento a 360 gradi. Insegnanti tutti preparati e alla mano.',
    author: 'Giorgia Armagno',
  },
];

const latestPosts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf())
  .slice(0, 4);
---

<BaseLayout
  title="Passion Fitness | Palestre Roma"
  description="Passion Fitness | Palestre Roma | Passion Fitness Tuscolana"
>
  <Hero
    title="PASSION FITNESS"
    video="/videos/hero-provvisorio.mp4"
    image="/images/uploads/2024/11/MRZ08075.jpeg"
  >
    <p>La palestra più grande delle zone Tuscolana, Cinecittà, Don Bosco e San Policarpo.<br />Un luogo dove persone diverse, con obiettivi unici, trovano il proprio percorso ideale per sentirsi meglio, insieme.</p>
    <div class="hero-ctas">
      <Button href={PROVA_URL} variant="dark-red">Prova Passion Fitness</Button>
      <Button href="/orari-corsi/" variant="ghost-dark">Scopri i Corsi</Button>
    </div>
  </Hero>

  <section class="quicklinks-section">
    <div class="quicklinks">
      {QUICKLINKS.map((item) => (
        <article class="quicklinks__card">
          <div class="quicklinks__bg" style={`background-image: url(${item.image})`}></div>
          <div class="quicklinks__overlay"></div>
          <div class="quicklinks__content">
            <div class="quicklinks__icon" set:html={QUICKLINK_ICONS[item.icon]} />
            <h3>{item.title}</h3>
            <p class="quicklinks__body">{item.body}</p>
            <a class="quicklinks__cta" href={item.href}>{item.cta}</a>
          </div>
        </article>
      ))}
    </div>
  </section>

  <section class="programmi-section" aria-label="Programmi Passion Fitness">
    <svg class="programmi-connectors" aria-hidden="true" preserveAspectRatio="none">
      <path class="programmi-connectors__path"></path>
    </svg>
    <div class="container programmi-split">
      <span class="programmi-split__badge" id="badge">programmi</span>
      <nav class="programmi-split__nav" aria-label="Vai al programma">
        {PROGRAMMI.map((p) => (
          <a class="programmi-split__nav-link" href={`#${p.id}`}>{p.title}</a>
        ))}
      </nav>
    </div>
    <div class="programmi">
      {PROGRAMMI.map((p) => (
        <article class="programma" id={p.id}>
          <div class="programma__media">
            <video src={p.video} autoplay muted loop playsinline></video>
          </div>
          <div class="programma__copy">
            <details class="programma__text" open>
              <summary class="programma__summary">
                <h3>{p.title}</h3>
                <span class="programma__toggle-icon" aria-hidden="true">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"></polyline></svg>
                </span>
              </summary>
              <div class="programma__details">
                <p>{p.body}</p>
                <Button href={p.href} variant="invert-red">{p.cta}</Button>
              </div>
            </details>
          </div>
        </article>
      ))}
    </div>
  </section>

  <script>
    // The <details> markup always renders `open` (desktop stays expanded via
    // pointer-events:none, no CSS fight over the [open] state). On mobile we
    // want it collapsed by default, so close it here in JS instead - but
    // only after it has actually laid out at least once while open. Closing
    // an accordion that has never been open collapses its content to a
    // 0-width box in current Chromium (a <details>/[open] sizing bug), so
    // the forced layout read (offsetHeight) before flipping `open` matters.
    function initProgrammiAccordion() {
      const detailsEls = document.querySelectorAll('.programma__text');
      const mobileQuery = window.matchMedia('(max-width: 760px)');

      function applyState() {
        detailsEls.forEach((el) => {
          if (mobileQuery.matches) {
            if (el.open) {
              void el.offsetHeight;
              el.open = false;
            }
          } else {
            el.open = true;
          }
        });
      }

      applyState();
      mobileQuery.addEventListener('change', applyState);
    }

    initProgrammiAccordion();

    function initProgrammiConnectors() {
      const section = document.querySelector('.programmi-section');
      const svg = document.querySelector('.programmi-connectors');
      const path = svg ? svg.querySelector('.programmi-connectors__path') : null;
      if (!section || !svg || !path) return;

      const radius = 10;
      const mobileQuery = window.matchMedia('(max-width: 760px)');
      // badge -> sala-pesi -> corsi-fitness -> i-love-my-trainer -> pilates-reformer
      const sequence = ['badge', 'sala-pesi', 'corsi-fitness', 'i-love-my-trainer', 'pilates-reformer'];
      // On mobile the line dives this many px past each accordion's edge, into
      // its own footprint, instead of stopping exactly at the border. Paired
      // with .programma__text sitting in a higher z-index than the connector
      // svg, the accordion always covers that stretch of line - open or
      // closed - so small measurement differences across devices never show
      // up as a visible gap or an overshoot poking out past the box.
      const mobileOverlap = 14;

      function resolveEl(id) {
        if (id === 'badge') return document.getElementById('badge');
        const article = document.getElementById(id);
        return article ? article.querySelector('.programma__text') : null;
      }

      // On mobile the video is shrunk to 7/8 width, leaving a 1/8 red sliver on
      // one side (left/right alternating like the desktop rows) with the
      // accordion overlapping the corner. The connector must only ever cross
      // that red sliver, never the video, so anchor to the sliver's horizontal
      // center instead of the accordion box's own center.
      function anchorX(id, rect, sectionRect) {
        const centerX = rect.left + rect.width / 2 - sectionRect.left;
        if (!mobileQuery.matches || id === 'badge') return centerX;

        const article = document.getElementById(id);
        const media = article ? article.querySelector('.programma__media') : null;
        if (!media) return centerX;

        const mediaRect = media.getBoundingClientRect();
        const rightGap = sectionRect.right - mediaRect.right;
        const leftGap = mediaRect.left - sectionRect.left;
        if (rightGap >= leftGap) {
          return mediaRect.right - sectionRect.left + rightGap / 2;
        }
        return mediaRect.left - sectionRect.left - leftGap / 2;
      }

      function update() {
        const sectionRect = section.getBoundingClientRect();
        svg.setAttribute('width', sectionRect.width);
        svg.setAttribute('height', sectionRect.height);
        svg.setAttribute('viewBox', `0 0 ${sectionRect.width} ${sectionRect.height}`);

        const isMobile = mobileQuery.matches;
        const subpaths = [];

        for (let i = 0; i < sequence.length - 1; i++) {
          const fromId = sequence[i];
          const toId = sequence[i + 1];
          const fromEl = resolveEl(fromId);
          const toEl = resolveEl(toId);
          const toArticle = document.getElementById(toId);
          if (!fromEl || !toEl || !toArticle) continue;

          const fromRect = fromEl.getBoundingClientRect();
          const toRect = toEl.getBoundingClientRect();
          const boundaryRect = toArticle.getBoundingClientRect();

          const x1 = anchorX(fromId, fromRect, sectionRect);
          const x2 = anchorX(toId, toRect, sectionRect);
          let y1 = fromRect.bottom - sectionRect.top;
          let y2 = toRect.top - sectionRect.top;
          if (isMobile) {
            // Dive into the source box too - including the "programmi" badge
            // itself (fromId === 'badge' on the first hop), which also sits
            // above the connector svg (.programmi-split z-index:5).
            y1 -= mobileOverlap;
            y2 += mobileOverlap;
          }
          const yMid = boundaryRect.top - sectionRect.top;

          const dir = x2 >= x1 ? 1 : -1;
          const r = Math.max(0, Math.min(radius, Math.abs(yMid - y1), Math.abs(y2 - yMid), Math.abs(x2 - x1) / 2));

          subpaths.push(
            `M ${x1} ${y1} V ${yMid - r} Q ${x1} ${yMid} ${x1 + r * dir} ${yMid} H ${x2 - r * dir} Q ${x2} ${yMid} ${x2} ${yMid + r} V ${y2}`
          );
        }

        path.setAttribute('d', subpaths.join(' '));
      }

      update();
      window.addEventListener('resize', update);
      window.addEventListener('load', update);

      if (window.ResizeObserver) {
        const observer = new ResizeObserver(() => update());
        observer.observe(document.body);
      }

      if (document.fonts && document.fonts.ready) {
        document.fonts.ready.then(update);
      }

      // Belt-and-suspenders: the very first synchronous measurement can run
      // before the grid CSS has actually been applied (module scripts fire at
      // DOMContentLoaded, not after stylesheets/fonts/video metadata settle),
      // and load/resize/ResizeObserver don't reliably fire again afterwards
      // on a static page. Re-measure a few more times to guarantee at least
      // one accurate pass regardless of exactly when layout settles.
      [50, 150, 300, 600, 1200, 2500].forEach((delay) => setTimeout(update, delay));
    }

    initProgrammiConnectors();
  </script>

  <FeatureShowcase
    title="Perché scegliere noi?"
    images={[
      { src: '/images/uploads/2024/11/MRZ08075.jpeg', alt: 'Passion Fitness Tuscolana' },
      { src: '/images/uploads/2024/11/Sala-Pesi-1.jpeg', alt: 'Sala pesi Passion Fitness' },
      { src: '/images/uploads/2024/10/sale_fitness.jpg', alt: 'Sala corsi fitness' },
      { src: '/images/uploads/2024/11/reform_1-1.jpeg', alt: 'Studio Pilates Reformer' },
      { src: '/images/uploads/2024/10/Palestra-11920x.jpg', alt: 'Palestra Passion Fitness' },
      { src: '/images/uploads/2024/11/MRZ08109.jpeg', alt: 'Personal training Passion Fitness' },
    ]}
    features={[
      '30+ anni di esperienza nel settore',
      "La persona sempre al centro, prima dell'allenamento",
      "Tutta l'attenzione che meriti, ad ogni allenamento",
      'Ti alleniamo al tuo fianco, finché non acquisirai piena sicurezza',
    ]}
  />

  <Section tone="dark">
    <div class="stats">
      <div class="stat">
        <span class="stat__num">30+</span>
        <span class="stat__label">Anni nel settore</span>
      </div>
      <div class="stat">
        <span class="stat__num">2000</span>
        <span class="stat__label">m² dedicati al fitness</span>
      </div>
      <div class="stat">
        <span class="stat__num">1000</span>
        <span class="stat__label">mq di sala pesi</span>
      </div>
      <div class="stat">
        <span class="stat__num">2+2</span>
        <span class="stat__label">Sale fitness e studi reformer</span>
      </div>
    </div>
  </Section>

  <RelatedSection title="Cosa dicono di noi">
    {TESTIMONIANZE.map((t) => (
      <figure class="testimonial">
        <blockquote>"{t.quote}"</blockquote>
        <figcaption>{t.author} <span>— Recensione Google</span></figcaption>
      </figure>
    ))}
  </RelatedSection>

  <RelatedSection title="Il blog di Passion">
    {latestPosts.map((post) => (
      <RelatedCard
        title={post.data.title}
        href={`/${post.data.slug}/`}
        image={post.data.coverImage}
        alt={post.data.title}
      />
    ))}
  </RelatedSection>

  <CtaSplit
    heading="Pronto a iniziare?"
    text="Il primo allenamento è gratuito e senza impegno: vieni a scoprire Passion Fitness."
    buttonLabel="Prova Passion Fitness"
    buttonHref={PROVA_URL}
    image="/images/uploads/2024/11/MRZ08075.jpeg"
    alt="Passion Fitness Tuscolana"
  />
</BaseLayout>

<style>
  .hero-ctas {
    display: flex;
    gap: var(--space-xs);
    flex-wrap: wrap;
    margin-top: var(--space-2xs);
  }
  /* Solo sulla home: il logo nell'header gia' mostra il brand, quindi su
     mobile il titolo "Passion Fitness" nell'hero e' ridondante e va nascosto.
     Le altre pagine che usano Hero con video (PageLayout) non hanno questa
     ridondanza e devono invece mostrare il titolo. */
  @media (max-width: 860px) {
    :global(.hero:has(.hero-media) .hero-title-group) {
      display: none;
    }
  }

  .quicklinks-section {
    height: 100vh;
    border-top: 2px solid var(--color-black);
  }
  .quicklinks {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    height: 100%;
  }
  .quicklinks__card {
    position: relative;
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .quicklinks__card:not(:first-child) {
    border-left: 2px solid var(--color-black);
  }
  .quicklinks__bg {
    position: absolute;
    inset: 0;
    background-size: cover;
    background-position: center;
  }
  .quicklinks__overlay {
    position: absolute;
    inset: 0;
    background: rgba(0, 0, 0, 0.6);
    transition: background-color 0.3s ease;
  }
  .quicklinks__card:hover .quicklinks__overlay {
    background: var(--accent);
  }
  .quicklinks__content {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: var(--space-2xs);
    padding: var(--space-lg) var(--space-md);
    max-width: 26rem;
  }
  .quicklinks__icon {
    width: 3.25rem;
    height: 3.25rem;
    color: var(--color-white);
    opacity: 0;
    max-height: 0;
    overflow: hidden;
    transition: opacity 0.25s ease, max-height 0.25s ease, margin-bottom 0.25s ease;
  }
  .quicklinks__card:hover .quicklinks__icon {
    opacity: 1;
    max-height: 4rem;
    margin-bottom: var(--space-2xs);
  }
  .quicklinks__icon svg {
    width: 100%;
    height: 100%;
  }
  .quicklinks__content h3 {
    color: var(--color-white);
    font-size: clamp(1.8rem, 3vw, 2.4rem);
  }
  .quicklinks__body {
    color: var(--text-on-dark-muted);
    font-size: 0.95rem;
    line-height: 1.5;
    opacity: 0;
    max-height: 0;
    margin: 0;
    overflow: hidden;
    transition: opacity 0.25s ease, max-height 0.25s ease, margin-block 0.25s ease;
  }
  .quicklinks__card:hover .quicklinks__body {
    opacity: 1;
    max-height: 12rem;
    margin-block: var(--space-2xs);
  }
  .quicklinks__cta {
    display: inline-block;
    width: fit-content;
    margin-top: var(--space-sm);
    padding: 0.85rem 1.5rem;
    background: var(--color-white);
    color: var(--text-on-light);
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    border-radius: 8px;
    transition: background-color 0.15s ease, color 0.15s ease;
  }
  .quicklinks__cta:hover {
    background: var(--color-black);
    color: var(--color-white);
  }
  .quicklinks__link {
    display: inline-block;
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--color-red);
  }
  @media (max-width: 760px) {
    .quicklinks-section {
      height: auto;
    }
    .quicklinks {
      grid-template-columns: 1fr;
    }
    .quicklinks__card {
      min-height: 24rem;
      border-left: none;
    }
    .quicklinks__card:not(:first-child) {
      border-left: none;
      border-top: 2px solid var(--color-black);
    }
  }

  .programmi-section {
    position: relative;
    background: var(--accent);
    border-top: 2px solid var(--color-black);
    border-bottom: 2px solid var(--color-black);
  }
  .programmi-connectors {
    position: absolute;
    inset: 0;
    z-index: 1;
    pointer-events: none;
  }
  .programmi-connectors__path {
    fill: none;
    stroke: var(--color-black);
    stroke-width: 2px;
    stroke-linecap: square;
  }
  .programmi-split {
    position: relative;
    z-index: 5;
    display: flex;
    align-items: flex-start;
    flex-wrap: wrap;
    gap: var(--space-md) var(--space-sm);
    margin-bottom: var(--space-md);
  }
  .programmi-split__badge {
    display: inline-block;
    background: var(--bg-light-soft);
    border: 2px solid var(--color-black);
    color: var(--color-black);
    font-family: var(--font-display);
    text-transform: lowercase;
    font-size: clamp(2rem, 4.2vw, 3.2rem);
    line-height: 1;
    padding: 0.15em 0.4em;
    border-radius: 12px;
    transform: translateY(-50%);
  }
  .programmi-split__nav {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-start;
    gap: var(--space-xs) var(--space-sm);
  }
  .programmi-split__nav-link {
    display: inline-block;
    background: var(--color-black);
