---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/ui/Hero.astro';
import Section from '../components/ui/Section.astro';
import Button from '../components/ui/Button.astro';
import CtaSplit from '../components/ui/CtaSplit.astro';
import FeatureShowcase from '../components/ui/FeatureShowcase.astro';
import RelatedSection from '../components/ui/RelatedSection.astro';
import RelatedCard from '../components/ui/RelatedCard.astro';
import ContentRows from '../components/ui/ContentRows.astro';
import ContentRow from '../components/ui/ContentRow.astro';

const PROVA_URL =
  'https://automazione.n8ndevelop.it/form/8ce36c5e-0cc4-4813-9a0f-2da2a7605fb0?source=SitoWeb&medium=Btn_Home';
const ABBONAMENTI_URL = 'https://passion.perfectgym.com/clientportal2/#/Registration';

const QUICKLINKS = [
  {
    title: 'Planning',
    body: "Oltre 250 lezioni al mese tra Rebalance, Energy, Pilates e Reformer, distribuite su più sale e studi dedicati. Consulta gli orari aggiornati in tempo reale e organizza la tua settimana di allenamento in pochi secondi.",
    href: '/orari-corsi/',
    cta: 'Scopri il planning',
    icon: 'calendar',
    image: '/images/uploads/2025/01/corso-di-step-min-1168x600-1.jpg',
  },
  {
    title: 'Abbonamenti',
    body: 'Dalla sala pesi in accesso libero ai pacchetti di Personal Training, fino alle formule Open pensate per chi si allena senza vincoli di orario. Scegli la soluzione più adatta al tuo obiettivo e al tuo budget.',
    href: ABBONAMENTI_URL,
    cta: 'Scopri gli abbonamenti',
    icon: 'dumbbell',
    image: '/images/uploads/2024/10/Palestra-11920x.jpg',
  },
  {
    title: 'Prova Open',
    body: "Vieni a scoprire di persona sala pesi, corsi fitness e studi Reformer con un accesso gratuito e senza impegno. Il nostro staff ti guida nella scelta del percorso più adatto a te fin dal primo allenamento.",
    href: PROVA_URL,
    cta: 'Prova ora',
    icon: 'heart-arm',
    image: '/images/uploads/2024/11/MRZ01857-scaled.jpeg',
  },
];

const QUICKLINK_ICONS = {
  calendar:
    '<svg viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="9" y="8" width="30" height="34" rx="3"/><rect x="17" y="4" width="14" height="8" rx="2"/><line x1="15" y1="21" x2="33" y2="21"/><line x1="15" y1="28" x2="33" y2="28"/><line x1="15" y1="35" x2="25" y2="35"/></svg>',
  dumbbell:
    '<svg viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="10" cy="20" r="5"/><circle cx="15" cy="28" r="4"/><line x1="15" y1="24" x2="31" y2="12"/><circle cx="35" cy="16" r="4"/><circle cx="40" cy="22" r="3"/></svg>',
  'heart-arm':
    '<svg viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M8 36c0-11 6-21 17-23-2 6 0 11 6 11"/><path d="M29 11c2-3 6-3 8 0 2-3 6-3 8 0 0 4-4 8-8 10-4-2-8-6-8-10Z"/></svg>',
};

const FAQ = [
  {
    q: 'Quali sono gli orari di apertura della palestra?',
    a: 'Passion Fitness Tuscolana è aperta tutti i giorni, dalle 5 alle 24.',
  },
  {
    q: 'Verrò seguito/a dai personal trainer in sala pesi?',
    a: "Di più! Con la formula I Love My Trainer acquisti direttamente le lezioni individuali, a partire da 65€/mese, con un Personal Trainer che si dedicherà unicamente a te.",
  },
  {
    q: 'Posso acquistare online gli abbonamenti?',
    a: 'Sì, accedendo alla sezione degli abbonamenti online puoi iscriverti scegliendo la tipologia di abbonamento desiderato.',
  },
];

const latestPosts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf())
  .slice(0, 3);
---

<BaseLayout
  title="Passion Fitness | Palestre Roma"
  description="Passion Fitness | Palestre Roma | Passion Fitness Tuscolana"
>
  <Hero
    title="PASSION FITNESS"
    video="/videos/hero-provvisorio.mp4"
    image="/images/uploads/2024/11/MRZ08075.jpeg"
  >
    <p>La palestra più grande delle zone Tuscolana, Cinecittà, Don Bosco e San Policarpo.<br />Un luogo dove persone diverse, con obiettivi unici, trovano il proprio percorso ideale per sentirsi meglio, insieme.</p>
    <div class="hero-ctas">
      <Button href={PROVA_URL} variant="dark-red">Prova Passion Fitness</Button>
      <Button href="/orari-corsi/" variant="ghost-dark">Scopri i Corsi</Button>
    </div>
  </Hero>

  <section class="quicklinks-section">
    <div class="quicklinks">
      {QUICKLINKS.map((item) => (
        <article class="quicklinks__card">
          <div class="quicklinks__bg" style={`background-image: url(${item.image})`}></div>
          <div class="quicklinks__overlay"></div>
          <div class="quicklinks__content">
            <div class="quicklinks__icon" set:html={QUICKLINK_ICONS[item.icon]} />
            <h3>{item.title}</h3>
            <p class="quicklinks__body">{item.body}</p>
            <a class="quicklinks__cta" href={item.href}>{item.cta}</a>
          </div>
        </article>
      ))}
    </div>
  </section>

  <Section tone="dark">
    <div class="stats">
      <div class="stat">
        <span class="stat__num">30+</span>
        <span class="stat__label">Anni nel settore</span>
      </div>
      <div class="stat">
        <span class="stat__num">2000</span>
        <span class="stat__label">m² dedicati al fitness</span>
      </div>
      <div class="stat">
        <span class="stat__num">1000</span>
        <span class="stat__label">mq di sala pesi</span>
      </div>
      <div class="stat">
        <span class="stat__num">2+2</span>
        <span class="stat__label">Sale fitness e studi reformer</span>
      </div>
    </div>
  </Section>

  <div class="home-flow">
  <div class="programmi-band">
    <ContentRows>
      <ContentRow
        title="Sala Pesi"
        video="/videos/2024/11/Sala-Pesi_Passion-Fitness.mp4"
        alt="Sala pesi Passion Fitness"
      >
        <p>Oltre 95 postazioni con <strong>macchinari Technogym e Panatta di ultima generazione</strong>, pensati per il massimo coinvolgimento muscolare e un allenamento sempre all'avanguardia.</p>
        <p>Aperti <strong>tutti i giorni dalle 5:00 alle 24:00</strong>, anche a Natale e Ferragosto: zona free weight, area calisthenics e area booty training per ogni tipo di allenamento.</p>
        <Button href="/palestra/sala-pesi/" variant="white">Vai alla Sala Pesi</Button>
      </ContentRow>

      <ContentRow
        title="Corsi Fitness"
        video="/videos/2025/02/Metcon-2.mp4"
        alt="Corsi fitness Passion Fitness"
      >
        <p><strong>2 sale dedicate</strong>, corsi dalle 7:00 alle 21:30: oltre 120 ore mensili di lezioni <strong>Rebalance</strong> (Pilates, Pilates Barre, Posturale, Yoga) per lavorare su mobilità e postura.</p>
        <p>A queste si aggiungono oltre 130 ore di lezioni <strong>Energy</strong> (Pump, Met-Con, Prepugilistica, Funzionale, Booty Pump), per chi cerca un allenamento più intenso e dinamico.</p>
        <Button href="/palestra/corsi-fitness/" variant="white">Vai ai Corsi Fitness</Button>
      </ContentRow>

      <ContentRow
        title="I Love My Trainer"
        video="/videos/2024/11/I-love-my-trainer-2.mp4"
        alt="Personal training Passion Fitness"
      >
        <p>Con la formula <strong>I Love My Trainer</strong> acquisti lezioni individuali con uno dei nostri Personal Trainer, ricevendo in omaggio l'abbonamento in palestra.</p>
        <p>Un percorso su misura, a partire da <strong>65€/mese</strong>, pensato per chi vuole risultati concreti con la massima attenzione e personalizzazione.</p>
        <Button href="/i-love-my-trainer/" variant="white">Vai al Personal Training</Button>
      </ContentRow>

      <ContentRow
        title="Reformer"
        video="/videos/2024/10/reformer_senza_testi.mp4"
        alt="Pilates Reformer Passion Fitness"
      >
        <p><strong>3 sale interamente dedicate al Reformer</strong>: Studio Reformer per chi inizia, Studio Reformer Plus per livelli intermedi e avanzati.</p>
        <p>Studio PT Reformer per lezioni individuali con <strong>Reformer, Cadillac e Chair</strong>: la prima lezione è gratuita, paghi solo 10€ di assicurazione.</p>
        <Button href="/pilates-reformer/" variant="white">Vai al Reformer</Button>
      </ContentRow>
    </ContentRows>
  </div>

  <div class="showcase-home">
    <FeatureShowcase
      title="Perché scegliere noi?"
      images={[
        { src: '/images/uploads/2024/11/MRZ08075.jpeg', alt: 'Passion Fitness Tuscolana' },
        { src: '/images/uploads/2024/11/Sala-Pesi-1.jpeg', alt: 'Sala pesi Passion Fitness' },
        { src: '/images/uploads/2024/10/sale_fitness.jpg', alt: 'Sala corsi fitness' },
        { src: '/images/uploads/2024/11/reform_1-1.jpeg', alt: 'Studio Pilates Reformer' },
        { src: '/images/uploads/2024/10/Palestra-11920x.jpg', alt: 'Palestra Passion Fitness' },
        { src: '/images/uploads/2024/11/MRZ08109.jpeg', alt: 'Personal training Passion Fitness' },
      ]}
      features={[
        '30+ anni di esperienza nel settore',
        "La persona sempre al centro, prima dell'allenamento",
        "Tutta l'attenzione che meriti, ad ogni allenamento",
        'Ti alleniamo al tuo fianco, finché non acquisirai piena sicurezza',
      ]}
    />
  </div>

  <div class="cta-split-home">
    <CtaSplit
      heading="Pronto a iniziare?"
      text="Il primo allenamento è gratuito e senza impegno: vieni a scoprire Passion Fitness."
      buttonLabel="Prova Passion Fitness"
      buttonHref={PROVA_URL}
      image="/images/uploads/2024/11/MRZ08075.jpeg"
      alt="Passion Fitness Tuscolana"
    />
  </div>
  </div>

  <div class="blog-home">
    <RelatedSection title="Leggi il nostro Blog">
      {latestPosts.map((post) => (
        <RelatedCard
          title={post.data.title}
          href={`/${post.data.slug}/`}
          image={post.data.coverImage}
          alt={post.data.title}
        />
      ))}
    </RelatedSection>
  </div>
</BaseLayout>

<style>
  .hero-ctas {
    display: flex;
    gap: var(--space-xs);
    flex-wrap: wrap;
    margin-top: var(--space-2xs);
  }
  /* Solo sulla home: il logo nell'header gia' mostra il brand, quindi su
     mobile il titolo "Passion Fitness" nell'hero e' ridondante e va nascosto.
     Le altre pagine che usano Hero con video (PageLayout) non hanno questa
     ridondanza e devono invece mostrare il titolo. */
  @media (max-width: 860px) {
    :global(.hero:has(.hero-media) .hero-title-group) {
      display: none;
    }
    /* Un solo CTA, piu' grande: "Scopri i Corsi" e' secondario e sulla
       larghezza di un telefono affiancare due bottoni li rende entrambi
       troppo piccoli per essere il gesto principale della hero. */
    .hero-ctas :global(a:last-child) {
      display: none;
    }
    .hero-ctas :global(a:first-child) {
      width: 100%;
      justify-content: center;
      font-size: 0.95rem;
      padding: 1.15rem 2rem;
    }
  }

  .quicklinks-section {
    height: 100vh;
    border-top: 2px solid var(--color-black);
  }
  .quicklinks {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    height: 100%;
  }
  .quicklinks__card {
    position: relative;
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .quicklinks__card:not(:first-child) {
    border-left: 2px solid var(--color-black);
  }
  .quicklinks__bg {
    position: absolute;
    inset: 0;
    background-size: cover;
    background-position: center;
  }
  .quicklinks__overlay {
    position: absolute;
    inset: 0;
    background: rgba(0, 0, 0, 0.6);
    transition: background-color 0.3s ease;
  }
  .quicklinks__card:hover .quicklinks__overlay {
    background: var(--accent);
  }
  .quicklinks__content {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: var(--space-2xs);
    padding: var(--space-lg) var(--space-md);
    max-width: 26rem;
  }
  .quicklinks__icon {
    width: 3.25rem;
    height: 3.25rem;
    color: var(--color-white);
    opacity: 0;
    max-height: 0;
    overflow: hidden;
    transition: opacity 0.25s ease, max-height 0.25s ease, margin-bottom 0.25s ease;
  }
  .quicklinks__card:hover .quicklinks__icon {
    opacity: 1;
    max-height: 4rem;
    margin-bottom: var(--space-2xs);
  }
  .quicklinks__icon svg {
    width: 100%;
    height: 100%;
  }
  .quicklinks__content h3 {
    color: var(--color-white);
    font-size: clamp(1.8rem, 3vw, 2.4rem);
  }
  .quicklinks__body {
    color: var(--text-on-dark-muted);
    font-size: 0.95rem;
    line-height: 1.5;
    opacity: 0;
    max-height: 0;
    margin: 0;
    overflow: hidden;
    transition: opacity 0.25s ease, max-height 0.25s ease, margin-block 0.25s ease;
  }
  .quicklinks__card:hover .quicklinks__body {
    opacity: 1;
    max-height: 12rem;
    margin-block: var(--space-2xs);
  }
  .quicklinks__cta {
    display: inline-block;
    width: fit-content;
    margin-top: var(--space-sm);
    padding: 0.85rem 1.5rem;
    background: var(--color-white);
    color: var(--text-on-light);
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    border-radius: 8px;
    transition: background-color 0.15s ease, color 0.15s ease;
  }
  .quicklinks__cta:hover {
    background: var(--color-black);
    color: var(--color-white);
  }
  .quicklinks__link {
    display: inline-block;
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--color-red);
  }
  @media (max-width: 760px) {
    .quicklinks-section {
      height: auto;
    }
    .quicklinks {
      grid-template-columns: 1fr;
    }
    .quicklinks__card {
      min-height: 24rem;
      border-left: none;
    }
    .quicklinks__card:not(:first-child) {
      border-left: none;
      border-top: 2px solid var(--color-black);
    }
  }

  .home-flow {
    display: flex;
    flex-direction: column;
  }
  @media (max-width: 860px) {
    /* Ordine richiesto su mobile: perche' scegliere noi, poi pronto a
       iniziare (le due insieme in una sola schermata), poi la griglia
       video+testo. Il markup resta nell'ordine desktop, qui si riordina
       solo visivamente. */
    .home-flow > .showcase-home {
      order: 1;
    }
    .home-flow > .cta-split-home {
      order: 2;
    }
    .home-flow > .programmi-band {
      order: 3;
    }
  }

  .programmi-band {
    background: var(--bg-light-soft);
  }
  /* Il lato testo deve formare un blocco uguale e opposto a quello del
     video (che ha gia' un bordo nero squadrato): stesso trattamento,
     cosi' i due lati sembrano un'unica card divisa a meta'. Il lato
     attaccato al video perde il proprio bordo (il video ha gia' il suo
     su quello stesso confine): altrimenti i due bordi affiancati si
     leggerebbero come una linea doppia. */
  .programmi-band :global(.content-row__copy) {
    border: 2px solid var(--color-black);
  }
  .programmi-band :global(.content-row:nth-child(odd) .content-row__copy) {
    border-left: none;
  }
  .programmi-band :global(.content-row:nth-child(even) .content-row__copy) {
    border-right: none;
  }
  /* Il pulsante non deve leggersi come un box a se' dentro il box del
     testo (altro doppio bordo, stavolta col proprio riquadro bianco):
     nessuno sfondo, nessun bordo, solo scritta e freccia. */
  .programmi-band :global(.content-row__copy .button),
  .programmi-band :global(.content-row__copy .button:hover) {
    background: transparent;
    color: var(--text-on-light);
    border-color: transparent;
    padding-inline: 0;
  }
  @media (max-width: 860px) {
    /* Il titolo si stacca dal box del paragrafo e va sopra al video: serve
       "smontare" .content-row__copy (display:contents) cosi' i suoi due
       figli (h2 e .content-row__text) diventano item della griglia di
       .content-row alla pari di .content-row__media, riordinabili a
       piacere con `order` senza toccare il markup del componente
       condiviso (che resta intatto per tutte le altre pagine). */
    .programmi-band :global(.content-row__copy) {
      display: contents;
    }
    /* !important: sulle righe pari il componente base ha una regola piu'
       specifica (.content-row:nth-child(even) .content-row__media) che
       resetta l'order a 0 per il layout mobile a sliver - qui va scavalcata
       sempre, altrimenti solo le righe dispari (Sala Pesi, I Love My
       Trainer) mostrano il titolo sopra al video. */
    .programmi-band :global(.content-row__media) {
      order: 2 !important;
    }
    /* .programmi-band ripetuto due volte: stessa specificita' della regola
       base del componente (2 classi + 2 attributi data-astro-cid), che
       altrimenti vincerebbe a parita' di punteggio in base al solo ordine
       di caricamento dei due file CSS (non affidabile). */
    .programmi-band.programmi-band :global(.content-row__copy h2) {
      order: 1;
      margin: 0;
      background: var(--accent);
      color: var(--color-white);
      padding: var(--space-sm) clamp(1.25rem, 4vw, 2.5rem);
      /* Il banner ora e' a piena larghezza (prima era testo inline con
         margine attorno): scivolare di lato di 56px lo farebbe sforare dal
         viewport (e' esattamente quello che spingeva la pagina intera a
         scorrere in orizzontale). Resta solo il fade, senza traslazione. */
      transform: none;
    }
    /* Il bordo che prima stava sul box intero (.content-row__copy) si
       sposta sul paragrafo, l'unica parte che lo conserva ancora. */
    .programmi-band :global(.content-row__text) {
      order: 3;
      border: 2px solid var(--color-black);
      border-top: none;
      background: var(--bg-light-soft);
      padding: var(--space-md) clamp(1.25rem, 4vw, 2.5rem);
    }
  }

  /* La sezione "prova" segue la stessa altezza (non piu' 100vh) e ha un
     bordo tra le due meta', come le righe video+testo qui sopra. */
  .cta-split-home :global(.cta-split) {
    height: auto;
    min-height: 30rem;
  }
  .cta-split-home :global(.cta-split__copy) {
    border-right: 2px solid var(--color-black);
  }
  @media (max-width: 860px) {
    .cta-split-home :global(.cta-split__copy) {
      border-right: none;
      border-bottom: 2px solid var(--color-black);
    }
    /* Solo testo: l'immagine non aggiunge informazione e sulla larghezza
       di un telefono ruberebbe spazio al messaggio e alla CTA. Senza
       immagine da riempire, il box torna a dimensionarsi sul contenuto:
       niente piu' min-height da schermata intera. */
    .cta-split-home :global(.cta-split) {
      grid-template-rows: none;
      min-height: 0;
    }
    .cta-split-home :global(.cta-split__copy) {
      padding-block: var(--space-xs);
      gap: var(--space-2xs);
      border-bottom: none;
    }
    .cta-split-home :global(.cta-split__media) {
      display: none;
    }
  }

  @media (max-width: 860px) {
    /* La galleria segue il testo (si legge il "perche'" prima di guardare
       le foto) e passa da 3 a 2 colonne, cosi' con 6 immagini restano 3
       righe piene invece di 2. */
    .showcase-home :global(.showcase__gallery) {
      order: 2;
      grid-template-columns: repeat(2, 1fr);
    }
    .showcase-home :global(.showcase__features) {
      order: 1;
      /* Meno padding e meno spazio tra gli elementi: qui sotto deve
         entrarci anche "pronto a iniziare", nella stessa schermata. */
      padding-block: var(--space-xs);
      gap: var(--space-2xs);
    }
    .showcase-home :global(.showcase__features ul) {
      gap: var(--space-3xs);
    }
    /* Righe basse (2/1 invece di 4/3): la galleria e' un corredo visivo,
       non ha bisogno di essere alta quanto larga per farsi riconoscere. */
    .showcase-home :global(.showcase__gallery-item) {
      aspect-ratio: 2 / 1;
    }
    /* Stesso motivo del titolo della sezione programmi: su un pannello a
       piena larghezza come questo, l'ingresso laterale (56px) sfora dal
       viewport e forza tutta la pagina a scorrere in orizzontale.
       !important perche' la regola base vive in un altro file CSS: la
       specificita' relativa tra i due dipende dall'ordine di caricamento,
       non affidabile. */
    .showcase-home :global(.showcase__features h2),
    .showcase-home :global(.showcase__features ul) {
      transform: none !important;
    }
  }

  @media (max-width: 860px) {
    /* Titolo + card del blog in una schermata sola: le card diventano righe
       compatte (miniatura a sinistra, titolo a destra) invece di grandi
       box con immagine sopra e barra sotto. */
    .blog-home.blog-home :global(.related-section__grid > a) {
      height: auto;
    }
    .blog-home :global(.related-section__title) {
      padding: var(--space-sm) var(--space-md);
    }
    .blog-home :global(.related-card) {
      flex-direction: row;
      border-width: 1.5px;
    }
    .blog-home :global(.related-card__media) {
      flex: 0 0 4.5rem;
      min-height: 0;
      aspect-ratio: 1;
      border-right: 1.5px solid var(--color-black);
    }
    .blog-home :global(.related-card__bar) {
      flex: 1;
      min-width: 0;
      padding: var(--space-2xs) var(--space-sm);
    }
    .blog-home :global(.related-card__title) {
      font-size: 0.85rem;
      line-height: 1.25;
    }
  }

  .stats {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(11rem, 1fr));
    gap: var(--space-md);
  }
  @media (max-width: 860px) {
    .stats {
      grid-template-columns: repeat(2, 1fr);
    }
  }
