---
import type { CollectionEntry } from 'astro:content';
import BaseLayout from './BaseLayout.astro';
import Hero from '../components/ui/Hero.astro';
import Button from '../components/ui/Button.astro';
import PostBody from '../components/blog/PostBody.astro';

interface Props {
  page: CollectionEntry<'pages'>;
}

const { page } = Astro.props;
const { title, heroImage, heroVideo, heroEyebrow, heroText, heroCtas, seo } = page.data;
---

<BaseLayout
  title={seo?.title || title}
  description={seo?.description}
  ogImage={seo?.ogImage}
  noindex={seo?.noindex}
>
  <Hero title={title} image={heroImage} video={heroVideo} eyebrow={heroEyebrow}>
    {heroText && <p set:html={heroText} />}
    {heroCtas && heroCtas.length > 0 && (
      <div class="hero-ctas">
        {heroCtas.map((cta) => (
          <Button href={cta.href} variant={cta.variant}>{cta.label}</Button>
        ))}
      </div>
    )}
  </Hero>
  <PostBody>
    <slot />
  </PostBody>
</BaseLayout>

{/* Nessuno stile locale: le CTA dell'hero sono stilate in global.css,
    identiche qui e sulla home. */}
