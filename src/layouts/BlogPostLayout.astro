---
import type { CollectionEntry } from 'astro:content';
import BaseLayout from './BaseLayout.astro';
import Hero from '../components/ui/Hero.astro';
import PostBody from '../components/blog/PostBody.astro';

interface Props {
  post: CollectionEntry<'blog'>;
}

const { post } = Astro.props;
const { title, coverImage, excerpt, categories, tags, publishedAt, seo } = post.data;
---

<BaseLayout
  title={seo?.title || title}
  description={seo?.description || excerpt}
  ogImage={seo?.ogImage || coverImage}
>
  <Hero title={title} image={coverImage} />
  <p class="post-meta">
    <time datetime={publishedAt.toISOString()}>{publishedAt.toLocaleDateString('it-IT')}</time>
    {categories.length > 0 && <span> · {categories.join(', ')}</span>}
  </p>
  <PostBody>
    <slot />
  </PostBody>
  {tags.length > 0 && (
    <ul class="post-tags">
      {tags.map((tag) => <li>{tag}</li>)}
    </ul>
  )}
</BaseLayout>

<style>
  .post-meta {
    max-width: 48rem;
    margin-inline: auto;
    padding-inline: clamp(1.25rem, 4vw, 2.5rem);
    padding-top: var(--space-lg);
    font-family: var(--font-body);
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-red);
  }
  .post-meta time {
    color: var(--text-on-light-muted);
  }

  .post-tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2xs);
    max-width: 48rem;
    margin-inline: auto;
    padding-inline: clamp(1.25rem, 4vw, 2.5rem);
    padding-bottom: var(--space-lg);
    list-style: none;
  }
  .post-tags li {
    background: var(--color-black);
    color: var(--color-white);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    padding: 0.4em 0.8em;
    border-radius: 8px;
  }
</style>
