---
// Elenco di domande frequenti ad accordion (<details> nativo, nessuno script).
// Le risposte accettano HTML inline (link, grassetti).
//
//   <FaqAccordion items={[{ q: 'Domanda?', a: 'Risposta con <a href="...">link</a>.' }]} />
interface Item {
  q: string;
  a: string;
}

interface Props {
  items: Item[];
}

const { items } = Astro.props;
---

<section class="faq">
  <div class="container">
    {items.map((item) => (
      <details class="faq__item">
        <summary class="faq__question">
          <span>{item.q}</span>
          <span class="faq__icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"></polyline></svg>
          </span>
        </summary>
        <p class="faq__answer" set:html={item.a} />
      </details>
    ))}
  </div>
</section>

<style>
  /* Fascia a piena larghezza col contenuto nel container del sito: allineata
     alle altre sezioni invece di stare nella colonna di lettura. */
  .faq {
    padding-bottom: var(--space-lg);
  }
  .faq > .container > .faq__item:first-child {
    border-top: 2px solid var(--color-black);
  }
  .faq__item {
    border-bottom: 2px solid var(--color-black);
  }
  .faq__question {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-sm);
    padding-block: var(--space-sm);
    font-family: var(--font-display);
    text-transform: uppercase;
    font-size: 1.05rem;
    line-height: 1.15;
    color: var(--text-on-light);
    cursor: pointer;
    list-style: none;
  }
  .faq__question::-webkit-details-marker {
    display: none;
  }
  .faq__item[open] .faq__question {
    color: var(--color-red);
  }
  .faq__icon {
    flex-shrink: 0;
    display: inline-flex;
    width: 1.1rem;
    height: 1.1rem;
    color: var(--color-red);
    transition: transform 0.2s ease;
  }
  .faq__item[open] .faq__icon {
    transform: rotate(180deg);
  }
  /* Due classi: la tipografia della risposta resta del componente, anche se
     PostBody dovesse tornare a definire regole discendenti sui <p>. */
  .faq .faq__answer {
    /* Misura di lettura: nel container pieno le righe sarebbero troppo
       lunghe per un testo scorrevole. */
    max-width: 62ch;
    color: var(--text-on-light);
    font-size: 1rem;
    line-height: 1.7;
    padding-bottom: var(--space-sm);
    margin: 0;
  }
  .faq .faq__answer :global(a) {
    color: var(--color-red);
    text-decoration: underline;
    text-underline-offset: 0.15em;
    font-weight: 600;
  }
</style>
