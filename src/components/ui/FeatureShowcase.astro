---
// Sezione 2/2 full-bleed: a sinistra una gallery di immagini, a destra il
// titolo e l'elenco delle caratteristiche (solo pro, nessun confronto).
//
//   <FeatureShowcase
//     title="Perché scegliere la Sala Pesi di Passion"
//     images={[{ src: '/images/...', alt: '...' }, ...]}   (6 immagini)
//     features={['Aperti tutti i giorni dalle 5:00 alle 24:00', ...]}
//   >
//     <CtaSplit slot="cta" ... />      (opzionale)
//   </FeatureShowcase>
//
// Lo slot "cta" ospita la fascia rossa di chiusura: su desktop resta una
// fascia a se' sotto la sezione (come se fosse un fratello), su mobile si
// infila tra l'elenco dei punti di forza e la gallery, cosi' testo + CTA
// stanno in una schermata e le foto restano per ultime.
//
// `mergeCta` (solo desktop): invece di una fascia a tutta larghezza sotto,
// il riquadro di testo della CTA prende il posto della sua immagine (che
// viene nascosta) nella colonna destra, alla stessa altezza dell'elenco.
// La gallery si allunga a coprire l'intera colonna sinistra (elenco + CTA)
// e passa da 3x2 a 2x3, per restare proporzionata alla nuova altezza.
interface ImageItem {
  src: string;
  alt?: string;
}

interface Props {
  title: string;
  images: ImageItem[];
  features: string[];
  mergeCta?: boolean;
}

const { title, images, features, mergeCta = false } = Astro.props;
---

<section class:list={["showcase", { "showcase--merge-cta": mergeCta }]} data-reveal>
  <div class="showcase__gallery">
    {images.map((img) => (
      <div class="showcase__gallery-item">
        <img src={img.src} alt={img.alt ?? ''} loading="lazy" />
      </div>
    ))}
  </div>
  <div class="showcase__features">
    <h2>{title}</h2>
    <ul>
      {features.map((feature) => (
        <li>
          <span class="showcase__mark" aria-hidden="true">✓</span>
          <span>{feature}</span>
        </li>
      ))}
    </ul>
  </div>
  {Astro.slots.has('cta') && (
    <div class="showcase__cta">
      <slot name="cta" />
    </div>
  )}
</section>

<style>
  .showcase {
    display: grid;
    grid-template-columns: 1fr 1fr;
    /* La prima riga (gallery + elenco) conserva l'altezza minima di prima;
       la seconda, se c'e' la CTA slottata, si dimensiona sul contenuto. */
    grid-template-rows: minmax(34rem, auto);
    grid-auto-rows: auto;
  }
  /* La CTA slottata e' una fascia a se': occupa tutta la riga sotto le due
     colonne, quindi da desktop non si distingue da un fratello della
     sezione (com'era prima di diventare uno slot). */
  .showcase__cta {
    grid-column: 1 / -1;
  }
  /* Nota: lo slot non impone altezza ne' bordi alla CTA su desktop, cosi'
     ogni pagina mantiene l'aspetto che aveva prima (100vh di default dal
     componente, oppure una fascia piu' bassa se la pagina lo richiede). */

  /* --- Variante mergeCta (solo desktop: sotto gli 861px il layout torna
     quello impilato del media query in fondo al file, che gia' resetta
     grid-template-columns/rows per l'intera .showcase). --- */
  @media (min-width: 861px) {
    /* Le due righe insieme (elenco + CTA) devono stare in una schermata:
       molto meno dei 34rem di partenza (pensati per una sezione con la
       sola gallery a tutta altezza sopra), ridotte anche nella riga CTA. */
    .showcase--merge-cta {
      grid-template-rows: minmax(22rem, auto) auto;
    }
    .showcase--merge-cta .showcase__gallery {
      /* Copre entrambe le righe (elenco + CTA): la stessa colonna sinistra
         che prima si fermava alla prima riga. */
      grid-row: 1 / -1;
      /* 2x3 invece di 3x2: colonne piu' larghe, proporzionate alla nuova
         altezza doppia della gallery. */
      grid-template-columns: repeat(2, 1fr);
    }
    .showcase--merge-cta .showcase__features {
      grid-row: 1;
      padding-block: var(--space-md);
    }
    .showcase--merge-cta .showcase__cta {
      /* Non piu' una fascia a tutta larghezza: solo la colonna destra,
         seconda riga - dove prima c'era l'immagine della CTA. */
      grid-column: 2;
      grid-row: 2;
    }
    /* L'immagine della CTA sparisce (la gallery ne prende visivamente il
       posto): il riquadro di testo riempie da solo tutta la colonna. */
    .showcase--merge-cta .showcase__cta :global(.cta-split) {
      grid-template-columns: 1fr;
      /* Il componente base ha height:100vh (fascia a schermo intero): va
         azzerato esplicitamente, non basta min-height a farlo restringere. */
      height: auto;
      min-height: 18rem;
    }
    .showcase--merge-cta .showcase__cta :global(.cta-split__media) {
      display: none;
    }
    .showcase--merge-cta .showcase__cta :global(.cta-split__copy) {
      border-right: none;
      padding-block: var(--space-md);
    }
  }

  @media (max-width: 860px) {
    /* Su mobile, invece, questa sezione deve coprire un'intera schermata
       (non piu' stare compatta insieme ad altro): padding molto piu'
       generosi sui due box, cosi' la coppia elenco+CTA si allunga a
       occupare tutto lo spazio verticale disponibile. */
    .showcase--merge-cta .showcase__features {
      padding-block: 6rem;
    }
    .showcase--merge-cta .showcase__cta :global(.cta-split__copy) {
      padding-block: 7rem;
    }
  }

  .showcase__gallery {
    display: grid;
    /* 3 colonne fisse + righe automatiche: regge qualsiasi numero di
       immagini (6 -> 2 righe piene, 9 -> 3). Usa multipli di 3 per non
       lasciare celle vuote nell'ultima riga. */
    grid-template-columns: repeat(3, 1fr);
    grid-auto-rows: 1fr;
    gap: 2px;
    background: var(--color-black);
  }
  .showcase__gallery-item {
    position: relative;
    overflow: hidden;
  }
  .showcase__gallery-item img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  /* Velo nero su ogni immagine, sparisce in hover sulla singola cella. */
  .showcase__gallery-item::after {
    content: "";
    position: absolute;
    inset: 0;
    background: rgba(0, 0, 0, 0.6);
    transition: opacity 0.3s ease;
  }
  .showcase__gallery-item:hover::after {
    opacity: 0;
  }

  .showcase__features {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: var(--space-md);
    background: var(--color-black);
    padding: var(--space-lg) clamp(1.5rem, 5vw, 4rem);
  }
  .showcase .showcase__features h2 {
    color: var(--color-red);
    margin-top: 0;
    opacity: 0;
    transform: translateX(3.5rem);
    transition: opacity 0.6s ease, transform 0.7s cubic-bezier(0.22, 0.61, 0.36, 1);
  }
  .showcase .showcase__features ul {
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
    list-style: none;
    padding: 0;
    margin: 0;
    opacity: 0;
    transform: translateX(3.5rem);
    transition: opacity 0.6s ease 0.1s, transform 0.7s cubic-bezier(0.22, 0.61, 0.36, 1) 0.1s;
  }
  .showcase.is-visible .showcase__features h2,
  .showcase.is-visible .showcase__features ul {
    opacity: 1;
    transform: none;
  }
  @media (prefers-reduced-motion: reduce) {
    .showcase .showcase__features h2,
    .showcase .showcase__features ul {
      opacity: 1;
      transform: none;
      transition: none;
    }
  }
  .showcase .showcase__features li {
    display: flex;
    align-items: baseline;
    gap: var(--space-xs);
    color: var(--color-white);
    font-size: 1.05rem;
    line-height: 1.4;
    padding-inline-start: 0;
  }
  /* La spunta e' l'unico marcatore: neutralizza un eventuale pallino
     ereditato dalle regole delle liste di PostBody. */
  .showcase .showcase__features li::before {
    content: none;
  }
  .showcase__mark {
    flex-shrink: 0;
    color: var(--color-red);
    font-size: 1.1rem;
    font-weight: 700;
  }

  @media (max-width: 860px) {
    .showcase {
      grid-template-columns: 1fr;
      grid-template-rows: none;
    }
    /* Ordine mobile: prima si legge il "perche'", poi (se c'e') la CTA,
       e per ultime le foto. */
    .showcase__features {
      order: 1;
      /* Spaziatura compatta: elenco + CTA devono stare in una schermata. */
      padding: var(--space-xs) clamp(1.25rem, 4vw, 2.5rem);
      gap: var(--space-2xs);
    }
    .showcase .showcase__features ul {
      gap: var(--space-3xs);
    }
    .showcase__cta {
      order: 2;
    }
    /* Senza immagine (la nasconde CtaSplit su mobile) non c'e' una seconda
       meta' da separare, ne' un'altezza minima da riempire: la fascia si
       dimensiona sul testo, cosi' sta in schermata insieme all'elenco. */
    .showcase__cta :global(.cta-split) {
      height: auto;
      min-height: 0;
    }
    .showcase__cta :global(.cta-split__copy) {
      border-right: none;
    }
    .showcase__gallery {
      order: 3;
      /* Su mobile la fascia non ha piu' un'altezza da riempire: la
         proporzione la impone la singola cella, cosi' regge qualsiasi
         numero di immagini. Due colonne (con 6 foto: 3 righe piene). */
      grid-template-columns: repeat(2, 1fr);
      grid-auto-rows: auto;
    }
    /* Celle basse: la gallery e' un corredo visivo, non deve rubare
       schermate di scorrimento. */
    .showcase__gallery-item {
      aspect-ratio: 2 / 1;
    }
    /* Niente ingresso laterale su mobile: titolo ed elenco sono blocchi a
       piena larghezza, traslarli di 3.5rem li fa sforare dal viewport e
       costringe l'intera pagina a scorrere in orizzontale. Resta il fade. */
    .showcase .showcase__features h2,
    .showcase .showcase__features ul {
      transform: none;
    }
  }
</style>
