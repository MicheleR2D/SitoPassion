---
// Sezione CTA a schermo pieno: fascia rossa con testo a sinistra e immagine a
// destra. Occupa una schermata intera del device.
//
//   <CtaSplit
//     heading="..."
//     text="..."            (opzionale)
//     buttonLabel="Prova Ora"
//     buttonHref="..."
//     image="/images/..."
//     compact                (opzionale: mezza schermata invece di una intera,
//                              per le pagine dove la fascia segue gia' molto
//                              contenuto ed e' l'ultima cosa prima del footer)
//   />
import Button from './Button.astro';

interface Props {
  heading: string;
  text?: string;
  buttonLabel: string;
  buttonHref: string;
  buttonVariant?: 'primary' | 'white' | 'dark-red' | 'invert-red' | 'ghost-dark' | 'ghost-light';
  image: string;
  alt?: string;
  compact?: boolean;
}

const {
  heading,
  text,
  buttonLabel,
  buttonHref,
  buttonVariant = 'dark-red',
  image,
  alt = '',
  compact = false,
} = Astro.props;
---

<section class:list={['cta-split', { 'cta-split--compact': compact }]} data-reveal>
  <div class="cta-split__copy">
    <h2>{heading}</h2>
    {text && <p>{text}</p>}
    <Button href={buttonHref} variant={buttonVariant}>{buttonLabel}</Button>
  </div>
  <div class="cta-split__media">
    <img src={image} alt={alt} loading="lazy" />
  </div>
</section>

<style>
  .cta-split {
    display: grid;
    grid-template-columns: 1fr 1fr;
    /* height, non min-height: deve coprire AL MASSIMO una schermata, non
       crescere oltre se il testo e' lungo (in tal caso scorre, vedi sotto). */
    height: 100vh;
    background: var(--accent);
    border-block: 2px solid var(--color-black);
  }
  .cta-split--compact {
    height: 50vh;
  }
  .cta-split__copy {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    justify-content: center;
    gap: var(--space-sm);
    padding: var(--space-lg) clamp(1.5rem, 5vw, 4rem);
    overflow-y: auto;
  }
  .cta-split .cta-split__copy h2 {
    color: var(--color-black);
    margin-top: 0;
    opacity: 0;
    transform: translateX(-3.5rem);
    transition: opacity 0.6s ease, transform 0.7s cubic-bezier(0.22, 0.61, 0.36, 1);
  }
  /* Due classi: il componente resta padrone della propria tipografia. */
  .cta-split .cta-split__copy p {
    color: var(--color-white);
    line-height: 1.7;
    font-size: 1.05rem;
    opacity: 0;
    transition: opacity 0.8s ease 0.15s;
  }
  .cta-split.is-visible .cta-split__copy h2 {
    opacity: 1;
    transform: none;
  }
  .cta-split.is-visible .cta-split__copy p {
    opacity: 1;
  }
  @media (prefers-reduced-motion: reduce) {
    .cta-split .cta-split__copy h2,
    .cta-split .cta-split__copy p {
      opacity: 1;
      transform: none;
      transition: none;
    }
  }
  .cta-split__media {
    position: relative;
    overflow: hidden;
  }
  .cta-split__media img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* + totem: vedi «Il totem verticale del club» in styles/global.css */
  @media (max-width: 860px),
    (min-width: 900px) and (min-height: 1200px) and (max-aspect-ratio: 7/10) {
    /* Solo testo: sulla larghezza di un telefono l'immagine ruberebbe
       spazio al messaggio e alla CTA senza aggiungere informazione. Senza
       immagine da riempire, la fascia si dimensiona sul contenuto. */
    .cta-split {
      grid-template-columns: 1fr;
      grid-template-rows: none;
      height: auto;
      min-height: 0;
    }
    .cta-split__media {
      display: none;
    }
    .cta-split__copy {
      padding-block: var(--space-md);
      gap: var(--space-2xs);
    }
    /* Come negli altri blocchi a piena larghezza: nessuna traslazione
       laterale su mobile, altrimenti il titolo sfora dal viewport. */
    .cta-split .cta-split__copy h2 {
      transform: none;
    }
  }
</style>
