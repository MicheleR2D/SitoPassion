---
// Fascia di card a tutta larghezza: immagine di sfondo, overlay scuro che
// diventa rosso in hover, titolo sempre visibile, paragrafo e CTA rivelati
// in hover. E' la sezione dei "tre box" usata sotto l'hero.
//
//   <HighlightCards items={[{ title, body, image, href, cta }, ...]} />
interface Item {
  title: string;
  body: string;
  image: string;
  href?: string;
  cta?: string;
}

interface Props {
  items: Item[];
}

const { items } = Astro.props;
---

<section class="highlights">
  <div class="highlights__grid" style={`--cols: ${items.length}`}>
    {items.map((item) => (
      <article class="highlights__card">
        <div class="highlights__bg" style={`background-image: url(${item.image})`}></div>
        <div class="highlights__overlay"></div>
        <div class="highlights__content">
          <h3>{item.title}</h3>
          <p class="highlights__body">{item.body}</p>
          {item.href && item.cta && (
            <a class="highlights__cta" href={item.href}>
              {item.cta}
              <span aria-hidden="true">→</span>
            </a>
          )}
        </div>
      </article>
    ))}
  </div>
</section>

<style>
  .highlights {
    border-block: 2px solid var(--color-black);
  }
  .highlights__grid {
    display: grid;
    /* Una colonna per card, qualunque sia il numero (3 o 4 nelle pagine di
       questo sito). Sotto i 1100px scende a 2 per non comprimere il testo. */
    grid-template-columns: repeat(var(--cols, 3), 1fr);
    /* Mezza schermata: con i box a tutta altezza si scorreva troppo prima
       di arrivare al contenuto della pagina. In dvh (non vh) per non
       sforare quando la barra del browser mobile e' visibile. */
    min-height: 50vh;
    min-height: 50dvh;
    /* Separatori ottenuti con il gap sul fondo nero invece che con i bordi:
       restano corretti anche quando le card vanno a capo (tablet/mobile),
       dove un border-left finirebbe sul bordo sinistro della fascia. */
    gap: 2px;
    background: var(--color-black);
  }
  .highlights__card {
    position: relative;
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .highlights__bg {
    position: absolute;
    inset: 0;
    background-size: cover;
    background-position: center;
  }
  .highlights__overlay {
    position: absolute;
    inset: 0;
    background: rgba(0, 0, 0, 0.6);
    transition: background-color 0.3s ease;
  }
  .highlights__card:hover .highlights__overlay {
    background: var(--accent);
  }
  .highlights__content {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: var(--space-2xs);
    padding: var(--space-lg) var(--space-md);
    max-width: 26rem;
  }
  .highlights__content h3 {
    color: var(--color-white);
    font-size: clamp(1.6rem, 2.6vw, 2.2rem);
  }
  /* Selettore doppio di proposito: la regola sui <p> di PostBody e' un
     discendente (.post-body p) e batterebbe una singola classe qui. */
  .highlights__content .highlights__body {
    color: var(--text-on-dark-muted);
    font-size: 0.95rem;
    line-height: 1.5;
    opacity: 0;
    max-height: 0;
    margin: 0;
    overflow: hidden;
    transition: opacity 0.25s ease, max-height 0.25s ease, margin-block 0.25s ease,
      color 0.25s ease;
  }
  .highlights__card:hover .highlights__body {
    opacity: 1;
    max-height: 14rem;
    margin-block: var(--space-2xs);
    color: var(--color-white);
  }
  /* Solo scritta, nessun box: sottolineato bianco con freccia. Un riquadro
     bianco qui si leggerebbe come un box dentro il box della card. */
  .highlights__cta {
    display: inline-flex;
    align-items: center;
    gap: 0.4em;
    width: fit-content;
    margin-top: var(--space-sm);
    color: var(--color-white);
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }
  .highlights__cta span {
    transition: transform 0.15s ease;
  }
  .highlights__cta:hover span {
    transform: translateX(3px);
  }

  /* Con 4 card lo spazio per colonna scende sotto i ~270px: passa a 2 per
     riga prima che titolo e testo diventino illeggibili. */
  @media (max-width: 1100px) {
    .highlights__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 860px) {
    .highlights__grid {
      grid-template-columns: 1fr;
      min-height: 0;
    }
    /* Meta' altezza anche qui: tre card impilate a 22rem erano tre
       schermate di scorrimento prima del resto della pagina. */
    .highlights__card {
      min-height: 12rem;
    }
    /* Nota: il paragrafo resta rivelato solo in hover anche su mobile,
       come su desktop (nessun override qui). */
  }
</style>
