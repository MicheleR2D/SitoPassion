---
// Riga full-bleed con immagine su un lato e testo sull'altro. L'alternanza
// destra/sinistra e' automatica (:nth-child) come nella sezione "programmi"
// della home: righe dispari immagine a sinistra, righe pari immagine a destra.
// Va usata dentro <ContentRows>.
//
//   <ContentRows>
//     <ContentRow title="Titolo" image="/images/..." alt="...">
//       Paragrafo con **grassetto**.
//     </ContentRow>
//   </ContentRows>
interface Props {
  title?: string;
  image: string;
  alt?: string;
}

const { title, image, alt = '' } = Astro.props;
---

<article class="content-row">
  <div class="content-row__media">
    <img src={image} alt={alt} loading="lazy" />
  </div>
  <div class="content-row__copy">
    {title && <h2>{title}</h2>}
    <div class="content-row__text">
      <slot />
    </div>
  </div>
</article>

<style>
  .content-row {
    display: grid;
    /* 50/50 esatto: e' quello che fa coincidere l'angolo dell'immagine di
       una riga con quello della riga successiva (che ha l'immagine sul lato
       opposto). Con colonne asimmetriche il confine si sposta a seconda
       della riga e gli angoli non si toccano piu'. */
    grid-template-columns: 1fr 1fr;
    align-items: stretch;
    /* min-height, non height: gli angoli si toccano grazie al 50/50 + zero
       gap (l'angolo basso-destro dell'immagine di una riga cade sullo stesso
       punto di quello alto-sinistro della riga dopo, a prescindere dalle
       altezze). Lasciare crescere la riga evita la barra di scorrimento
       interna sulle pagine con piu' testo di questa. */
    min-height: 30rem;
    /* Direzione da cui entra il titolo: righe dispari (testo a destra)
       entrano da destra, righe pari (testo a sinistra) da sinistra. */
    --enter-from: 3.5rem;
  }
  .content-row:nth-child(even) {
    --enter-from: -3.5rem;
  }
  .content-row__media {
    position: relative;
    overflow: hidden;
    /* Angoli squadrati (non arrotondati), bordo nero come i box della
       sezione precedente (.highlights). L'altezza la riempie per intero
       (align-items:stretch sulla riga, che ora ha height fissa). */
    border: 2px solid var(--color-black);
  }
  .content-row__media img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .content-row__copy {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: var(--space-sm);
    padding: var(--space-lg) clamp(1.5rem, 5vw, 4rem);
  }
  .content-row__copy h2 {
    color: var(--color-red);
    opacity: 0;
    transform: translateX(var(--enter-from));
    transition: opacity 0.6s ease, transform 0.7s cubic-bezier(0.22, 0.61, 0.36, 1);
  }
  .content-row__text {
    opacity: 0;
    transition: opacity 0.8s ease 0.15s;
  }
  .content-row.is-visible .content-row__copy h2 {
    opacity: 1;
    transform: none;
  }
  .content-row.is-visible .content-row__text {
    opacity: 1;
  }
  @media (prefers-reduced-motion: reduce) {
    .content-row__copy h2,
    .content-row__text {
      opacity: 1;
      transform: none;
      transition: none;
    }
  }

  /* Righe pari: immagine a destra. Va spostata anche la traccia, non solo
     l'ordine visivo, altrimenti su griglie asimmetriche l'immagine
     resterebbe nella colonna sbagliata. */
  .content-row:nth-child(even) .content-row__media {
    order: 2;
  }

  /* Il testo slottato arriva dal file .mdx, quindi ha lo scope del genitore:
     serve :global() per raggiungerlo da qui. Selettore a due classi di
     proposito: il componente deve restare padrone della propria tipografia
     anche se un domani PostBody tornasse a definire regole discendenti. */
  .content-row .content-row__text :global(p) {
    color: var(--text-on-light);
    line-height: 1.75;
    font-size: 1.05rem;
  }
  .content-row .content-row__text :global(p + p) {
    margin-top: var(--space-sm);
  }
  .content-row .content-row__text :global(strong) {
    color: var(--color-red);
  }
  .content-row .content-row__text :global(a) {
    color: var(--color-red);
    text-decoration: underline;
    text-underline-offset: 0.15em;
    font-weight: 600;
  }

  @media (max-width: 860px) {
    .content-row,
    .content-row:nth-child(even) {
      grid-template-columns: 1fr;
      /* Su mobile le righe sono impilate, non affiancate: l'altezza fissa
         del desktop (serve solo a far coincidere gli angoli in orizzontale)
         non serve piu', l'immagine torna a un rapporto proprio. */
      height: auto;
    }
    .content-row__media {
      aspect-ratio: 4 / 3;
    }
    .content-row:nth-child(even) .content-row__media {
      order: 0;
    }
    .content-row__copy {
      padding: var(--space-md) clamp(1.25rem, 4vw, 2.5rem);
    }
  }
</style>
