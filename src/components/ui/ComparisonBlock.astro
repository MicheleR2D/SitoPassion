---
// Blocco "classico vs Passion": due colonne pro/contro, pattern che ricorre
// in quasi tutte le pagine programma/disciplina. Le liste puntate slottate
// ereditano lo stile (bullet rosso) gia' definito globalmente da PostBody.
interface Props {
  againstTitle: string;
  forTitle: string;
}

const { againstTitle, forTitle } = Astro.props;
---

<div class="comparison">
  <div class="comparison__col comparison__col--against">
    <h4>{againstTitle}</h4>
    <slot name="against" />
  </div>
  <div class="comparison__col comparison__col--for">
    <h4>{forTitle}</h4>
    <slot name="for" />
  </div>
</div>

<style>
  .comparison {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-md);
  }
  .comparison__col {
    border-radius: 12px;
    padding: var(--space-md);
  }
  .comparison__col--against {
    background: var(--bg-light);
    border: 2px solid var(--border-on-light);
  }
  .comparison__col--for {
    background: var(--color-black);
  }
  .comparison__col h4 {
    font-family: var(--font-display);
    text-transform: uppercase;
    font-size: clamp(1.1rem, 1.8vw, 1.4rem);
    margin-bottom: var(--space-sm);
  }
  .comparison__col--against h4 {
    color: var(--text-on-light-muted);
  }
  .comparison__col--for h4 {
    color: var(--color-red);
  }
  .comparison__col--for :global(p),
  .comparison__col--for :global(ul),
  .comparison__col--for :global(li) {
    color: var(--text-on-dark-muted);
  }
  .comparison__col :global(ul) {
    margin-top: 0 !important;
  }

  @media (max-width: 700px) {
    .comparison {
      grid-template-columns: 1fr;
    }
  }
</style>
