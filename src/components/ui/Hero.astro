---
interface Props {
  title: string;
  image?: string;
  video?: string;
  videoEndBuffer?: number;
  eyebrow?: string;
}

const { title, image, video, videoEndBuffer = 3, eyebrow } = Astro.props;
---

<div class="hero">
  {video && (
    <div class="hero-media">
      <video
        class="hero-media__video"
        src={video}
        poster={image}
        data-end-buffer={videoEndBuffer}
        autoplay
        muted
        playsinline
      />
    </div>
  )}
  {!video && image && (
    <div class="hero-photo">
      <img src={image} alt="" />
    </div>
  )}
  <div class="container hero-inner" class:list={{ "hero-inner--with-photo": image || video }}>
    <div class="hero-copy">
      <div class="hero-title-group">
        {eyebrow && <p class="eyebrow hero-eyebrow">{eyebrow}</p>}
        <h1>{title}</h1>
      </div>
      <div class="hero-extra">
        <slot />
      </div>
    </div>
  </div>
</div>

{video && (
  <script>
    document.querySelectorAll('.hero-media video').forEach((videoEl) => {
      const endBuffer = Number(videoEl.dataset.endBuffer ?? '3');
      videoEl.addEventListener('timeupdate', () => {
        if (videoEl.duration && videoEl.currentTime >= videoEl.duration - endBuffer) {
          videoEl.currentTime = 0;
        }
      });
    });
  </script>
)}

<style>
  .hero {
    position: relative;
    background: var(--bg-dark);
    overflow: hidden;
    margin-top: calc(-1 * var(--header-height));
    /* dvh (non vh) sui mobile browser: vh e' calcolato sull'altezza massima
       (barra degli indirizzi nascosta), quindi al primo caricamento (barra
       visibile) l'hero sfora oltre lo schermo reale. dvh segue l'altezza
       visibile per davvero, in ogni momento. vh resta come fallback per i
       browser che non supportano dvh. */
    height: 100vh;
    height: 100dvh;
  }
  .hero:not(:has(.hero-photo, .hero-media)) {
    height: auto;
  }
  .hero:has(.hero-media, .hero-photo) {
    display: grid;
    grid-template-columns: 2fr 1fr;
  }
  .hero:has(.hero-media, .hero-photo) .hero-inner {
    grid-column: 2;
    background: var(--accent);
    /* .hero-inner e' anche .container (margin-inline:auto), quindi senza
       questo si restringe al contenuto e la fascia rossa non riempie la
       colonna: sulle pagine senza testo slottato lasciava scoperto il nero
       del .hero ai lati. */
    width: 100%;
    margin-inline: 0;
  }
  .hero:has(.hero-media, .hero-photo) .hero-eyebrow {
    color: var(--color-white);
  }
  .hero:has(.hero-media, .hero-photo) h1,
  .hero:has(.hero-media, .hero-photo) .hero-extra {
    color: var(--color-white);
  }

  .hero-inner {
    position: relative;
    z-index: 1;
    height: 100%;
    display: flex;
    align-items: center;
    padding-top: var(--header-height);
  }
  .hero-copy {
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
    padding-block: clamp(1.5rem, 4vw, 3rem);
  }
  .hero-inner--with-photo .hero-copy {
    max-width: 34rem;
  }
  .hero-eyebrow {
    color: var(--color-red);
  }
  .hero h1 {
    color: var(--text-on-dark);
  }
  .hero-extra {
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
    color: var(--text-on-dark-muted);
  }
  .hero-extra p {
    line-height: 1.9;
  }

  /* Stesso trattamento di .hero-media (video): pannello immagine semplice
     nella colonna 2/3, non il vecchio taglio diagonale pre-redesign. */
  .hero-photo {
    position: relative;
    height: 100%;
    background: var(--color-black);
    overflow: hidden;
  }
  .hero-photo img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* --- Passaggio morbido tra media e pannello rosso ---
     Nessun bordo netto: una sfumatura esce dal pannello e si stende sul
     media. Il pannello resta pieno, sfuma solo la parte che sborda sul
     video, cosi' il testo mantiene il suo contrasto. Parte dal rosso
     pieno del pannello, altrimenti al confine si vedrebbe uno scalino. */
  .hero:has(.hero-media, .hero-photo) .hero-inner::before {
    content: "";
    position: absolute;
    inset-block: 0;
    /* subito a sinistra del pannello, sopra il media */
    right: 100%;
    width: min(20rem, 30vw);
    background: linear-gradient(to left, var(--accent), var(--accent-transparent));
    pointer-events: none;
  }

  .hero-media {
    position: relative;
    height: 100%;
    background: var(--color-black);
    overflow: hidden;
  }
  .hero-media__video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 25%;
  }

  @media (max-width: 860px) {
    /* Vale sia per il video sia per l'immagine: su mobile non serve la
       larghezza ridotta pensata per la colonna 1/3 desktop. */
    .hero-inner--with-photo .hero-copy {
      max-width: none;
    }

    .hero:has(.hero-media, .hero-photo) {
      grid-template-columns: 1fr;
      grid-template-rows: 2fr 1fr;
    }
    .hero:has(.hero-media, .hero-photo) .hero-inner {
      grid-column: 1;
      align-items: flex-start;
      padding-top: var(--space-sm);
    }
    /* Qui il pannello sta sotto il media, quindi la sfumatura sale invece
       di andare a sinistra. */
    .hero:has(.hero-media, .hero-photo) .hero-inner::before {
      /* inset-inline:0 azzera anche il right:100% del desktop: se lo si
         rimette a `auto` l'elemento resta senza larghezza (left:0 +
         right:auto + width:auto = 0px) e la sfumatura sparisce. */
      inset-block: auto;
      inset-inline: 0;
      bottom: 100%;
      width: auto;
      height: min(9rem, 18vh);
      background: linear-gradient(to top, var(--accent), var(--accent-transparent));
    }
    .hero:has(.hero-media, .hero-photo) .hero-copy {
      flex-direction: row;
      flex-wrap: wrap;
      align-items: center;
      gap: var(--space-sm);
      padding-block: 0;
    }
    .hero:has(.hero-media, .hero-photo) .hero-extra {
      flex: 1 1 100%;
      min-width: 0;
      gap: var(--space-2xs);
    }
    .hero:has(.hero-media, .hero-photo) .hero-extra :global(p) {
      font-size: 1.05rem;
      line-height: 1.45;
    }
    .hero:has(.hero-media, .hero-photo) :global(.hero-ctas) {
      flex-wrap: nowrap;
      gap: var(--space-3xs);
    }
    /* Su mobile la hero mostra una sola CTA (vedi global.css), quindi non
       serve piu' stringere font e padding per far stare due bottoni
       affiancati: resta solo il riempimento della riga. Le dimensioni le
       decidono global.css e, se serve, la pagina. */
    .hero:has(.hero-media, .hero-photo) :global(.hero-ctas) :global(.button) {
      flex: 1 1 auto;
      justify-content: center;
      border-width: 2px;
    }
  }
</style>
