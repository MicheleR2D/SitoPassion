---
// Unico posto dove servono regole tipografiche per il markdown/mdx renderizzato
// (contenuto lungo: h2-h6, paragrafi, liste, link, immagini, video, tabelle,
// blockquote, iframe embed). Tutte le pagine `pages`/`blog` passano da qui,
// quindi e' la leva piu' efficiente per allinearle allo stile della home.
---

<div class="post-body">
  <slot />
</div>

<style>
  .post-body {
    max-width: 48rem;
    margin-inline: auto;
    padding: var(--space-lg) clamp(1.25rem, 4vw, 2.5rem);
  }

  .post-body :global(h2),
  .post-body :global(h3),
  .post-body :global(h4) {
    margin-top: var(--space-xl);
  }
  .post-body :global(h4) {
    font-family: var(--font-display);
    text-transform: uppercase;
    letter-spacing: -0.01em;
    font-size: clamp(1.1rem, 1.8vw, 1.4rem);
    line-height: 1.1;
  }
  .post-body :global(h5),
  .post-body :global(h6) {
    margin-top: var(--space-lg);
    font-family: var(--font-body);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    font-size: 0.8rem;
  }

  .post-body :global(p),
  .post-body :global(ul),
  .post-body :global(ol),
  .post-body :global(table),
  .post-body :global(blockquote),
  .post-body :global(video),
  .post-body :global(iframe) {
    margin-top: var(--space-md);
  }

  .post-body :global(p) {
    color: var(--text-on-light-muted);
    line-height: 1.75;
  }
  .post-body :global(strong) {
    color: var(--text-on-light);
  }

  .post-body :global(ul),
  .post-body :global(ol) {
    color: var(--text-on-light-muted);
    line-height: 1.75;
    padding-inline-start: 1.3em;
  }
  .post-body :global(li + li) {
    margin-top: var(--space-2xs);
  }
  .post-body :global(ul) {
    list-style: none;
    padding-inline-start: 0;
  }
  .post-body :global(ul > li) {
    position: relative;
    padding-inline-start: 1.4em;
  }
  .post-body :global(ul > li)::before {
    content: "";
    position: absolute;
    left: 0.1em;
    top: 0.65em;
    width: 0.5em;
    height: 0.5em;
    background: var(--color-red);
    border-radius: 2px;
  }

  .post-body :global(a) {
    color: var(--color-red);
    text-decoration: underline;
    text-underline-offset: 0.15em;
    font-weight: 600;
  }
  .post-body :global(a:hover) {
    color: var(--color-red-hover);
  }
  /* Un link isolato nel proprio paragrafo, nei contenuti migrati da WordPress,
     e' quasi sempre una CTA in maiuscolo (es. "[PROVA GRATIS](...)"): la
     trasformiamo in un bottone invece che in un link sottolineato. Esclude i
     link-immagine (es. loghi cliccabili), che non devono avere il bordo. */
  .post-body :global(p > a:only-child:not(:has(img))) {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    background: transparent;
    color: var(--color-red);
    border: 4px solid var(--color-red);
    border-radius: 12px;
    padding: 0.9rem 1.75rem;
    font-family: var(--font-body);
    font-size: 0.85rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    text-decoration: none;
  }
  .post-body :global(p > a:only-child:not(:has(img)):hover) {
    background: var(--color-red);
    color: var(--color-white);
  }

  .post-body :global(img) {
    max-width: 100%;
    border-radius: 12px;
  }
  /* I contenuti migrati spesso affiancano piu' immagini nello stesso
     paragrafo: le trasformiamo in una piccola galleria invece di lasciarle
     una sull'altra come inline element di default. */
  .post-body :global(p:has(img)) {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-sm);
    justify-content: center;
  }
  .post-body :global(p:has(img) img) {
    flex: 1 1 260px;
    height: auto;
  }

  .post-body :global(video) {
    border-radius: 12px;
    width: 100%;
  }

  .post-body :global(iframe) {
    width: 100%;
    aspect-ratio: 16 / 9;
    border: none;
    border-radius: 12px;
  }

  .post-body :global(table) {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.95rem;
  }
  .post-body :global(th),
  .post-body :global(td) {
    border: 1px solid var(--border-on-light);
    padding: var(--space-xs) var(--space-sm);
    text-align: left;
  }
  .post-body :global(th) {
    background: var(--bg-light-soft);
    font-family: var(--font-body);
    font-weight: 700;
    text-transform: uppercase;
    font-size: 0.78rem;
    letter-spacing: 0.04em;
  }

  .post-body :global(blockquote) {
    border-left: 3px solid var(--color-red);
    margin-inline-start: 0;
    padding-inline-start: var(--space-sm);
    color: var(--text-on-light-muted);
    font-style: italic;
  }
</style>
