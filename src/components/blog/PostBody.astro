---
// Wrapper del contenuto markdown/mdx renderizzato.
//
// DUE REGOLE ARCHITETTURALI, da rispettare per non reintrodurre bug:
//
// 1. LAYOUT — pattern "content-grid": griglia a 3 colonne, la corsia centrale
//    ha una misura di lettura confortevole e le laterali fanno da margine.
//    Tutto va in corsia 2; i blocchi full-bleed (elencati sotto) escono in
//    corsia 1/-1. `row-gap` e' 0: nessuno spazio automatico tra fratelli, cosi'
//    due fasce adiacenti si toccano SEMPRE, in qualsiasi combinazione. Lo
//    spazio del testo scorrevole e' dato da margin-top espliciti.
//
// 2. TIPOGRAFIA — tutte le regole qui sotto sono limitate ai FIGLI DIRETTI
//    (`>`), cioe' al testo scritto direttamente nel .mdx. NON devono mai
//    raggiungere l'interno dei componenti: ogni componente definisce la
//    propria tipografia. Senza questo vincolo le regole di PostBody vincono
//    per specificita' su quelle dei componenti (es. il pallino rosso delle
//    liste che si sommava alla spunta dentro FeatureShowcase).
---

<div class="post-body">
  <slot />
</div>

<style>
  .post-body {
    --gutter: clamp(1.25rem, 4vw, 2.5rem);
    display: grid;
    grid-template-columns:
      1fr
      min(58rem, calc(100% - 2 * var(--gutter)))
      1fr;
    row-gap: 0;
    padding-bottom: var(--space-xl);
    /* Rosso chiaro come sfondo di pagina, come sulla home: mai bianco. */
    background: var(--bg-light-soft);
  }
  .post-body > :global(*) {
    grid-column: 2;
    min-width: 0;
  }

  /* --- Blocchi full-bleed ---
     Per aggiungere un nuovo componente a tutta larghezza basta inserire qui
     la sua classe radice. */
  .post-body > :global(.section),
  .post-body > :global(.cta),
  .post-body > :global(.highlights),
  .post-body > :global(.content-rows),
  .post-body > :global(.cta-split),
  .post-body > :global(.related-section),
  .post-body > :global(.showcase),
  .post-body > :global(.schedule),
  .post-body > :global(p:has(img + img)),
  .post-body > :global(p:has(video)),
  .post-body > :global(.full-bleed) {
    grid-column: 1 / -1;
  }
  /* Quando l'ultimo blocco della pagina e' full-bleed (related-section,
     showcase, cta-split, ...) deve toccare il footer: annulla il
     padding-bottom di .post-body, che serve solo quando l'ultimo elemento
     e' testo scorrevole. Su :last-child, non su una classe fissa: la pagina
     Orari Corsi ad esempio finisce con .showcase, non con .related-section. */
  .post-body > :global(.section):last-child,
  .post-body > :global(.cta):last-child,
  .post-body > :global(.highlights):last-child,
  .post-body > :global(.content-rows):last-child,
  .post-body > :global(.cta-split):last-child,
  .post-body > :global(.related-section):last-child,
  .post-body > :global(.showcase):last-child,
  .post-body > :global(.schedule):last-child,
  .post-body > :global(.full-bleed):last-child {
    margin-bottom: calc(-1 * var(--space-xl));
  }

  /* --- Spaziatura del testo scorrevole ---
     Esplicita, perche' row-gap e' 0 (vedi nota 1 in testa al file). */
  .post-body > :global(p),
  .post-body > :global(ul),
  .post-body > :global(ol),
  .post-body > :global(table),
  .post-body > :global(blockquote),
  .post-body > :global(video),
  .post-body > :global(iframe) {
    margin-top: var(--space-md);
  }
  .post-body > :global(h2),
  .post-body > :global(h3) {
    margin-top: var(--space-lg);
  }
  .post-body > :global(h4),
  .post-body > :global(h5),
  .post-body > :global(h6) {
    margin-top: var(--space-md);
  }

  /* --- Titoli --- */
  .post-body > :global(h4) {
    font-family: var(--font-display);
    text-transform: uppercase;
    letter-spacing: -0.01em;
    font-size: clamp(1.1rem, 1.8vw, 1.4rem);
    line-height: 1.1;
  }
  .post-body > :global(h5),
  .post-body > :global(h6) {
    font-family: var(--font-body);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    font-size: 0.8rem;
    color: var(--color-red);
  }

  /* --- Paragrafi --- */
  .post-body > :global(p) {
    color: var(--text-on-light-muted);
    line-height: 1.75;
    font-size: 1.05rem;
  }
  .post-body > :global(p) :global(strong) {
    color: var(--text-on-light);
  }

  /* --- Liste ---
     Il ::before e' agganciato alla ul di primo livello (ma raggiunge anche le
     li annidate) per non finire dentro i componenti. */
  .post-body > :global(ul),
  .post-body > :global(ol) {
    color: var(--text-on-light-muted);
    line-height: 1.75;
    padding-inline-start: 1.3em;
  }
  .post-body > :global(ul) :global(li + li),
  .post-body > :global(ol) :global(li + li) {
    margin-top: var(--space-2xs);
  }
  .post-body > :global(ul) {
    list-style: none;
    padding-inline-start: 0;
  }
  .post-body > :global(ul) :global(li) {
    position: relative;
    padding-inline-start: 1.4em;
  }
  .post-body > :global(ul) :global(li)::before {
    content: "";
    position: absolute;
    left: 0.1em;
    top: 0.62em;
    width: 0.5em;
    height: 0.5em;
    background: var(--color-red);
    border-radius: 2px;
  }

  /* --- Link nel testo --- */
  .post-body > :global(p) :global(a),
  .post-body > :global(ul) :global(a),
  .post-body > :global(ol) :global(a),
  .post-body > :global(table) :global(a) {
    color: var(--color-red);
    text-decoration: underline;
    text-underline-offset: 0.15em;
    font-weight: 600;
  }
  .post-body > :global(p) :global(a:hover),
  .post-body > :global(ul) :global(a:hover),
  .post-body > :global(ol) :global(a:hover),
  .post-body > :global(table) :global(a:hover) {
    color: var(--color-red-hover);
  }
  /* I <Button> nel testo non ereditano lo stile link. */
  .post-body :global(a.button) {
    text-decoration: none;
    font-weight: 700;
  }

  /* --- Immagini nel testo --- */
  .post-body > :global(p) :global(img) {
    max-width: 100%;
  }
  /* Immagine singola: contenuta e con proporzione fissa, mai gigante. */
  .post-body > :global(p) > :global(img:only-child) {
    width: 100%;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    border-radius: 12px;
  }
  /* Piu' immagini nello stesso paragrafo (artefatto della migrazione WP):
     diventano una galleria full-bleed a proporzioni uniformi. */
  .post-body > :global(p:has(img + img)) {
    display: grid;
    /* min() sul 48%: 4 colonne su desktop, 2 su mobile (senza il min() su
       mobile collasserebbe a colonna singola, impilando immagini alte). */
    grid-template-columns: repeat(auto-fit, minmax(min(20rem, 48%), 1fr));
    gap: 2px;
    background: var(--color-black);
    border-block: 2px solid var(--color-black);
  }
  .post-body > :global(p:has(img + img)) :global(img) {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    border-radius: 0;
  }

  /* --- Video / embed nel testo --- */
  .post-body > :global(video),
  .post-body > :global(p) :global(video) {
    width: 100%;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    border-block: 2px solid var(--color-black);
  }
  .post-body > :global(iframe),
  .post-body > :global(p) :global(iframe) {
    width: 100%;
    aspect-ratio: 16 / 9;
    border: none;
    border-radius: 12px;
  }

  /* --- Tabelle --- */
  .post-body > :global(table) {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.95rem;
  }
  .post-body > :global(table) :global(th),
  .post-body > :global(table) :global(td) {
    border: 1px solid var(--border-on-light);
    padding: var(--space-xs) var(--space-sm);
    text-align: left;
  }
  .post-body > :global(table) :global(th) {
    background: var(--bg-light-soft);
    font-family: var(--font-body);
    font-weight: 700;
    text-transform: uppercase;
    font-size: 0.78rem;
    letter-spacing: 0.04em;
  }

  .post-body > :global(blockquote) {
    border-left: 3px solid var(--color-red);
    margin-inline-start: 0;
    padding-inline-start: var(--space-sm);
    color: var(--text-on-light-muted);
    font-style: italic;
  }
</style>
