---
// Wrapper del contenuto markdown/mdx renderizzato.
//
// Usa il pattern "content-grid": una griglia a 3 colonne dove la corsia
// centrale ha una misura di lettura confortevole e le corsie laterali fanno
// da margine. Tutto finisce in corsia 2 per default, ma i blocchi che devono
// respirare a tutta larghezza (fasce <Section>, gallerie di immagini, CTA)
// escono in corsia 1/-1. Serve per riprodurre il linguaggio full-bleed della
// home - fasce di colore alternate, video edge-to-edge - dentro pagine che
// restano in gran parte contenuto scorrevole.
---

<div class="post-body">
  <slot />
</div>

<style>
  .post-body {
    --gutter: clamp(1.25rem, 4vw, 2.5rem);
    display: grid;
    grid-template-columns:
      1fr
      min(58rem, calc(100% - 2 * var(--gutter)))
      1fr;
    row-gap: var(--space-md);
    padding-bottom: var(--space-xl);
    /* Rosso chiaro come sfondo di pagina, come sulla home: mai bianco. */
    background: var(--bg-light-soft);
  }
  .post-body > :global(*) {
    grid-column: 2;
    min-width: 0;
  }

  /* Blocchi full-bleed: fasce colorate, card, righe alternate, CTA. */
  .post-body > :global(.section),
  .post-body > :global(.cta),
  .post-body > :global(.comparison),
  .post-body > :global(.highlights),
  .post-body > :global(.content-rows),
  .post-body > :global(p:has(img + img)),
  .post-body > :global(p:has(video)),
  .post-body > :global(.full-bleed) {
    grid-column: 1 / -1;
  }
  /* Fasce <Section> adiacenti: nessuno spazio morto, si leggono come fasce
     continue come sulla home. Le .content-rows gestiscono da sole il proprio
     respiro (padding-block), quindi non vanno compresse qui. */
  .post-body > :global(.section) + :global(.section) {
    margin-top: calc(-1 * var(--space-md));
  }

  /* --- Tipografia --- */
  .post-body :global(h2),
  .post-body :global(h3) {
    margin-top: var(--space-lg);
  }
  .post-body :global(h4) {
    margin-top: var(--space-md);
    font-family: var(--font-display);
    text-transform: uppercase;
    letter-spacing: -0.01em;
    font-size: clamp(1.1rem, 1.8vw, 1.4rem);
    line-height: 1.1;
  }
  .post-body :global(h5),
  .post-body :global(h6) {
    margin-top: var(--space-md);
    font-family: var(--font-body);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    font-size: 0.8rem;
    color: var(--color-red);
  }
  /* Dentro una fascia colorata la spaziatura la gestisce la fascia stessa. */
  .post-body :global(.section) :global(h2),
  .post-body :global(.section) :global(h3),
  .post-body :global(.section) :global(h4) {
    margin-top: 0;
  }

  .post-body :global(p) {
    color: var(--text-on-light-muted);
    line-height: 1.75;
    font-size: 1.05rem;
  }
  .post-body :global(strong) {
    color: var(--text-on-light);
  }

  /* --- Liste --- */
  .post-body :global(ul),
  .post-body :global(ol) {
    color: var(--text-on-light-muted);
    line-height: 1.75;
    padding-inline-start: 1.3em;
  }
  .post-body :global(li + li) {
    margin-top: var(--space-2xs);
  }
  .post-body :global(ul) {
    list-style: none;
    padding-inline-start: 0;
  }
  .post-body :global(ul > li) {
    position: relative;
    padding-inline-start: 1.4em;
  }
  .post-body :global(ul > li)::before {
    content: "";
    position: absolute;
    left: 0.1em;
    top: 0.62em;
    width: 0.5em;
    height: 0.5em;
    background: var(--color-red);
    border-radius: 2px;
  }

  /* --- Link ---
     Limitati ai link dentro il testo scorrevole (paragrafi, liste, tabelle):
     i componenti (card, CTA, bottoni) definiscono il proprio aspetto e non
     devono essere sovrascritti da qui. */
  .post-body :global(p) :global(a),
  .post-body :global(li) :global(a),
  .post-body :global(td) :global(a),
  .post-body :global(th) :global(a) {
    color: var(--color-red);
    text-decoration: underline;
    text-underline-offset: 0.15em;
    font-weight: 600;
  }
  .post-body :global(p) :global(a:hover),
  .post-body :global(li) :global(a:hover),
  .post-body :global(td) :global(a:hover),
  .post-body :global(th) :global(a:hover) {
    color: var(--color-red-hover);
  }
  /* I <Button> dentro al testo non devono ereditare lo stile link. */
  .post-body :global(a.button) {
    text-decoration: none;
    font-weight: 700;
  }

  /* --- Immagini --- */
  .post-body :global(img) {
    max-width: 100%;
  }
  /* Immagine singola: contenuta e con proporzione fissa, mai gigante. */
  .post-body :global(p > img:only-child) {
    width: 100%;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    border-radius: 12px;
  }
  /* Gruppo di immagini nello stesso paragrafo (artefatto della migrazione WP):
     diventa una galleria full-bleed a proporzioni uniformi, con lo stesso
     stacco di 2px usato come separatore sulla home. */
  .post-body > :global(p:has(img + img)) {
    display: grid;
    /* min() sul 48%: 4 colonne su desktop, 2 su mobile (senza il min() su
       mobile collasserebbe a colonna singola, impilando immagini alte). */
    grid-template-columns: repeat(auto-fit, minmax(min(20rem, 48%), 1fr));
    gap: 2px;
    background: var(--color-black);
    border-block: 2px solid var(--color-black);
  }
  .post-body :global(p:has(img + img) img) {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    border-radius: 0;
  }

  /* --- Video / embed --- */
  .post-body :global(video) {
    width: 100%;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    border-block: 2px solid var(--color-black);
  }
  .post-body :global(iframe) {
    width: 100%;
    aspect-ratio: 16 / 9;
    border: none;
    border-radius: 12px;
  }

  /* --- Tabelle --- */
  .post-body :global(table) {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.95rem;
  }
  .post-body :global(th),
  .post-body :global(td) {
    border: 1px solid var(--border-on-light);
    padding: var(--space-xs) var(--space-sm);
    text-align: left;
  }
  .post-body :global(th) {
    background: var(--bg-light-soft);
    font-family: var(--font-body);
    font-weight: 700;
    text-transform: uppercase;
    font-size: 0.78rem;
    letter-spacing: 0.04em;
  }

  .post-body :global(blockquote) {
    border-left: 3px solid var(--color-red);
    margin-inline-start: 0;
    padding-inline-start: var(--space-sm);
    color: var(--text-on-light-muted);
    font-style: italic;
  }
</style>
