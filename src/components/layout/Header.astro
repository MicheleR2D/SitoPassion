---
import Nav from './Nav.astro';
---

<header class="site-header">
  <div class="container site-header__inner">
    <a href="/" class="brand">
      <img src="/images/logo-header.png" alt="Passion Fitness Club" width="359" height="174" />
    </a>

    <input type="checkbox" id="nav-toggle" class="nav-toggle-input" />
    <label for="nav-toggle" class="nav-toggle" aria-label="Apri il menu">
      <span></span><span></span><span></span>
    </label>

    <div class="nav-panel">
      <Nav />
    </div>

    {/* I due comandi di destra in un contenitore solo, e non due elementi
        posizionati ognuno per conto suo: la barra si appoggia a un
        ancoraggio a due terzi della larghezza, e con due `calc` separati il
        secondo andava tenuto in pari col primo a mano — finiva addosso al
        menu appena la finestra si stringeva. Un contenitore, un ancoraggio,
        e la distanza fra i due la decide il `gap`.

        L'omino apre `AccountModal`, che sta nel BaseLayout. E' un pulsante e
        non un link perche' non porta a una pagina — apre un pannello — e su
        una barra dove tutto il resto naviga, la differenza si sente col
        lettore di schermo. */}
    <div class="header-azioni">
    <button
      class="account-btn"
      type="button"
      data-acct-open
      aria-label="Il tuo club"
      aria-haspopup="dialog"
      aria-expanded="false"
    >
      <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor"
        stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2" />
        <circle cx="12" cy="7" r="4" />
      </svg>
    </button>

    <a class="prova-gratis" href="https://automazione.n8ndevelop.it/form/8ce36c5e-0cc4-4813-9a0f-2da2a7605fb0?source=SitoWeb&medium=Btn_Header">
      Prova Ora <span aria-hidden="true">→</span>
    </a>
    </div>
  </div>
</header>

<script>
  const header = document.querySelector('.site-header');
  const updateHeaderState = () => {
    header?.classList.toggle('is-scrolled', window.scrollY > 40);
  };
  updateHeaderState();
  window.addEventListener('scroll', updateHeaderState, { passive: true });

  const scrollToHash = (hash: string, behavior: ScrollBehavior) => {
    const target = document.getElementById(decodeURIComponent(hash.slice(1)));
    if (!target) return false;
    // scrollIntoView e non un offset a mano: rispetta lo scroll-margin-top
    // dichiarato in global.css, che tiene conto dell'header fisso.
    target.scrollIntoView({ block: 'start', behavior });
    return true;
  };

  // Il menu mobile e' un checkbox CSS: un link al suo interno non lo chiude.
  // Sulle ancore della pagina corrente questo lo rendeva inservibile (il
  // pannello copre lo schermo, lo scroll avviene dietro e sembra che il tocco
  // non abbia fatto niente).
  const toggle = document.getElementById('nav-toggle') as HTMLInputElement | null;
  document.querySelector('.nav-panel')?.addEventListener('click', (event) => {
    const link = (event.target as Element | null)?.closest?.('a[href]') as HTMLAnchorElement | null;
    if (!link) return;
    if (toggle) toggle.checked = false;

    const url = new URL(link.href, location.href);
    const samePage = url.pathname === location.pathname && url.search === location.search;
    if (!samePage || !url.hash) return;

    // Stessa pagina: se l'hash e' identico a quello corrente il browser non
    // rifarebbe alcun salto, quindi lo si fa qui.
    event.preventDefault();
    if (location.hash !== url.hash) location.hash = url.hash;
    scrollToHash(url.hash, 'smooth');
  });

  // Arrivo su una pagina con l'ancora nell'URL: al load l'altezza puo' essere
  // cambiata (font, banner cookie, immagini) e il salto iniziale del browser
  // finisce fuori bersaglio. Qui si riassesta.
  window.addEventListener('load', () => {
    if (location.hash) scrollToHash(location.hash, 'auto');
  });
</script>

<style>
  .site-header {
    position: fixed;
    inset-block-start: 0;
    inset-inline: 0;
    z-index: 100;
    background: transparent;
    border-bottom: 1px solid transparent;
    transition: background-color 0.25s ease, border-color 0.25s ease;
  }
  .site-header.is-scrolled,
  .site-header:has(.nav-toggle-input:checked) {
    background: var(--bg-dark);
    border-bottom-color: var(--border-on-dark);
  }
  .site-header.is-scrolled .prova-gratis,
  .site-header.is-scrolled .account-btn {
    color: var(--color-red);
    border-color: var(--color-red);
  }
  .site-header.is-scrolled .account-btn:hover {
    background: var(--color-red);
    color: var(--color-white);
    border-color: var(--color-red-hover);
  }
  .site-header.is-scrolled .prova-gratis:hover {
    background: var(--color-red);
    color: var(--color-white);
    border-color: var(--color-red-hover);
  }
  .site-header__inner {
    display: flex;
    align-items: center;
    justify-content: flex-start;
    gap: var(--space-md);
    padding-block: var(--space-xs);
  }

  .brand {
    display: inline-flex;
    align-items: center;
    flex-shrink: 0;
  }
  .brand img {
    height: 4.25rem;
    width: auto;
  }

  /* L'ancoraggio dei comandi di destra: due terzi della larghezza piu' il
     margine del contenitore, com'era prima per il solo «Prova Ora». Ora lo
     porta il contenitore, e l'omino gli sta dentro. */
  .header-azioni {
    position: absolute;
    top: 50%;
    left: calc(66.6667% + var(--container-gutter));
    transform: translateY(-50%);
    display: flex;
    align-items: center;
    gap: 0.6rem;
  }

  .account-btn {
    flex-shrink: 0;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.85rem;
    height: 2.85rem;
    cursor: pointer;
    background: transparent;
    color: var(--color-white);
    border: 3px solid var(--color-white);
    border-radius: 10px;
    transition: background-color 0.15s ease, color 0.15s ease, border-color 0.15s ease;
  }
  .account-btn:hover {
    background: var(--color-white);
    color: var(--text-on-light);
    border-color: var(--color-white);
  }

  .prova-gratis {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    background: transparent;
    color: var(--color-white);
    border: 3px solid var(--color-white);
    border-radius: 10px;
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    padding: 0.75rem 1.25rem;
    white-space: nowrap;
    transition: background-color 0.15s ease, color 0.15s ease, border-color 0.15s ease;
  }
  .prova-gratis:hover {
    background: var(--color-white);
    color: var(--text-on-light);
    border-color: var(--color-white);
  }

  .nav-toggle-input {
    display: none;
  }
  .nav-toggle {
    display: none;
    flex-direction: column;
    justify-content: center;
    gap: 5px;
    width: 2rem;
    height: 2rem;
    cursor: pointer;
  }
  .nav-toggle span {
    display: block;
    height: 2px;
    background: var(--text-on-dark);
  }

  /* + totem: vedi «Il totem verticale del club» in styles/global.css */
  @media (max-width: 900px),
    (min-width: 900px) and (min-height: 1200px) and (max-aspect-ratio: 7/10) {
    .site-header__inner {
      flex-wrap: wrap;
      padding-block: var(--space-2xs);
      row-gap: 0;
      /* Il `gap` di 2rem di desktop, tenuto anche qui, faceva sforare la riga
         di due pixel — logo 80 + 32 + hamburger 32 + 32 + comandi 161 = 337
         contro i 335 disponibili a 375px — e l'hamburger finiva a capo da
         solo. La colonna si stringe: il `row-gap: 0` sopra resta, perche' la
         riga che va a capo e' il pannello del menu e non deve staccarsi
         dalla barra. */
      column-gap: var(--space-2xs);
    }
    .brand img {
      height: 3.25rem;
    }
    /* Su telefono i comandi rientrano nel flusso e si appoggiano a destra. */
    .header-azioni {
      position: static;
      transform: none;
      order: 1;
      margin-inline: auto;
      gap: 0.4rem;
    }
    .account-btn {
      width: 2.1rem;
      height: 2.1rem;
      border-width: 2px;
    }
    .account-btn svg {
      width: 16px;
      height: 16px;
    }
    .prova-gratis {
      font-size: 0.68rem;
      padding: 0.5rem 0.85rem;
      border-width: 2px;
    }
    /* L'hamburger all'estremita' destra della barra, e i due comandi al centro
       fra lui e il logo: `order` li mette in fila — logo, comandi, hamburger —
       e il `margin-inline: auto` sui comandi si mangia lo spazio che resta da
       entrambi i lati. E' un centraggio nello spazio libero, non nel viewport:
       logo e hamburger hanno larghezze diverse, quindi il gruppo non cade
       esattamente a meta' schermo. */
    .nav-toggle {
      display: flex;
      order: 2;
    }
    .nav-panel {
      order: 3;
      flex-basis: 100%;
      max-height: 0;
      overflow: hidden;
      transition: max-height 0.2s ease;
    }
    /* Menu aperto: pannello a schermo pieno sotto la barra. `top:100%` lo
       attacca sotto l'header e, siccome il blocco contenitore e' l'header
       stesso (position:fixed), `100%` nel calc e' proprio la sua altezza:
       l'altezza del pannello diventa "tutto il resto della schermata",
       senza dipendere da una variabile da tenere allineata a mano. */
    .nav-toggle-input:checked ~ .nav-panel {
      position: absolute;
      top: 100%;
      left: 0;
      right: 0;
      /* `vh` come ripiego per i browser senza `dvh` (pre-2022), `dvh` per
         tutti gli altri. Il ripiego NON e' scritto come doppia
         dichiarazione (`height: ...vh` seguita da `height: ...dvh`, lo
         schema di Hero.astro): dentro un `calc()` lightningcss riconosce
         le due righe come la stessa proprieta' e in build tiene solo
         l'ultima, quindi il ripiego sparirebbe dal CSS servito. Con
         `@supports` sono due regole distinte e sopravvivono entrambe. */
      height: calc(100vh - 100%);
      max-height: none;
      overflow-y: auto;
      background: var(--bg-dark);
    }
    @supports (height: 100dvh) {
      .nav-toggle-input:checked ~ .nav-panel {
        height: calc(100dvh - 100%);
      }
    }
    /* Il layout interno del menu aperto (griglia di riquadri) e' definito
       in Nav.astro: qui l'header si occupa solo di aprire e chiudere il
       pannello. */
  }
</style>
