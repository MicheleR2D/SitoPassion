---
import Nav from './Nav.astro';
---

<header class="site-header">
  <div class="container site-header__inner">
    <a href="/" class="brand">
      <img src="/images/logo-passion-mark.png" alt="Passion Fitness Club" width="1409" height="592" />
    </a>

    <input type="checkbox" id="nav-toggle" class="nav-toggle-input" />
    <label for="nav-toggle" class="nav-toggle" aria-label="Apri il menu">
      <span></span><span></span><span></span>
    </label>

    <div class="nav-panel">
      <Nav />
    </div>

    <a class="prova-gratis" href="https://automazione.n8ndevelop.it/form/8ce36c5e-0cc4-4813-9a0f-2da2a7605fb0?source=SitoWeb&medium=Btn_Header">
      Prova Ora <span aria-hidden="true">→</span>
    </a>
  </div>
</header>

<script>
  const header = document.querySelector('.site-header');
  const updateHeaderState = () => {
    header?.classList.toggle('is-scrolled', window.scrollY > 40);
  };
  updateHeaderState();
  window.addEventListener('scroll', updateHeaderState, { passive: true });

  const scrollToHash = (hash, behavior) => {
    const target = document.getElementById(decodeURIComponent(hash.slice(1)));
    if (!target) return false;
    // scrollIntoView e non un offset a mano: rispetta lo scroll-margin-top
    // dichiarato in global.css, che tiene conto dell'header fisso.
    target.scrollIntoView({ block: 'start', behavior });
    return true;
  };

  // Il menu mobile e' un checkbox CSS: un link al suo interno non lo chiude.
  // Sulle ancore della pagina corrente questo lo rendeva inservibile (il
  // pannello copre lo schermo, lo scroll avviene dietro e sembra che il tocco
  // non abbia fatto niente).
  const toggle = /** @type {HTMLInputElement | null} */ (document.getElementById('nav-toggle'));
  document.querySelector('.nav-panel')?.addEventListener('click', (event) => {
    const link = /** @type {HTMLElement} */ (event.target)?.closest?.('a[href]');
    if (!link) return;
    if (toggle) toggle.checked = false;

    const url = new URL(/** @type {HTMLAnchorElement} */ (link).href, location.href);
    const samePage = url.pathname === location.pathname && url.search === location.search;
    if (!samePage || !url.hash) return;

    // Stessa pagina: se l'hash e' identico a quello corrente il browser non
    // rifarebbe alcun salto, quindi lo si fa qui.
    event.preventDefault();
    if (location.hash !== url.hash) location.hash = url.hash;
    scrollToHash(url.hash, 'smooth');
  });

  // Arrivo su una pagina con l'ancora nell'URL: al load l'altezza puo' essere
  // cambiata (font, banner cookie, immagini) e il salto iniziale del browser
  // finisce fuori bersaglio. Qui si riassesta.
  window.addEventListener('load', () => {
    if (location.hash) scrollToHash(location.hash, 'auto');
  });
</script>

<style>
  .site-header {
    position: fixed;
    inset-block-start: 0;
    inset-inline: 0;
    z-index: 100;
    background: transparent;
    border-bottom: 1px solid transparent;
    transition: background-color 0.25s ease, border-color 0.25s ease;
  }
  .site-header.is-scrolled,
  .site-header:has(.nav-toggle-input:checked) {
    background: var(--bg-dark);
    border-bottom-color: var(--border-on-dark);
  }
  .site-header.is-scrolled .prova-gratis {
    color: var(--color-red);
    border-color: var(--color-red);
  }
  .site-header.is-scrolled .prova-gratis:hover {
    background: var(--color-red);
    color: var(--color-white);
    border-color: var(--color-red-hover);
  }
  .site-header__inner {
    display: flex;
    align-items: center;
    justify-content: flex-start;
    gap: var(--space-md);
    padding-block: var(--space-xs);
  }

  .brand {
    display: inline-flex;
    align-items: center;
    flex-shrink: 0;
  }
  .brand img {
    height: 2.75rem;
    width: auto;
  }

  .prova-gratis {
    position: absolute;
    top: 50%;
    left: calc(66.6667% + clamp(1.25rem, 4vw, 2.5rem));
    transform: translateY(-50%);
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    background: transparent;
    color: var(--color-white);
    border: 3px solid var(--color-white);
    border-radius: 10px;
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    padding: 0.75rem 1.25rem;
    white-space: nowrap;
    transition: background-color 0.15s ease, color 0.15s ease, border-color 0.15s ease;
  }
  .prova-gratis:hover {
    background: var(--color-white);
    color: var(--text-on-light);
    border-color: var(--color-white);
  }

  .nav-toggle-input {
    display: none;
  }
  .nav-toggle {
    display: none;
    flex-direction: column;
    justify-content: center;
    gap: 5px;
    width: 2rem;
    height: 2rem;
    cursor: pointer;
  }
  .nav-toggle span {
    display: block;
    height: 2px;
    background: var(--text-on-dark);
  }

  @media (max-width: 900px) {
    .site-header__inner {
      flex-wrap: wrap;
      padding-block: var(--space-2xs);
      row-gap: 0;
    }
    .brand img {
      height: 2.1rem;
    }
    .prova-gratis {
      position: static;
      transform: none;
      margin-left: auto;
      font-size: 0.68rem;
      padding: 0.5rem 0.85rem;
      border-width: 2px;
    }
    .nav-toggle {
      display: flex;
      order: 2;
    }
    .nav-panel {
      order: 3;
      flex-basis: 100%;
      max-height: 0;
      overflow: hidden;
      transition: max-height 0.2s ease;
    }
    /* Menu aperto: pannello a schermo pieno sotto la barra. `top:100%` lo
       attacca sotto l'header e, siccome il blocco contenitore e' l'header
       stesso (position:fixed), `100%` nel calc e' proprio la sua altezza:
       l'altezza del pannello diventa "tutto il resto della schermata",
       senza dipendere da una variabile da tenere allineata a mano. */
    .nav-toggle-input:checked ~ .nav-panel {
      position: absolute;
      top: 100%;
      left: 0;
      right: 0;
      height: calc(100dvh - 100%);
      max-height: none;
      overflow-y: auto;
      background: var(--bg-dark);
    }
    /* Il layout interno del menu aperto (griglia di riquadri) e' definito
       in Nav.astro: qui l'header si occupa solo di aprire e chiudere il
       pannello. */
  }
</style>
