---
import { NAV_ITEMS } from '../../data/nav.ts';
---

<nav class="site-nav">
  <ul>
    {NAV_ITEMS.map((item) => (
      <li
        class:list={[
          "site-nav__item",
          { "has-children": item.children, "site-nav__item--standalone": item.standalone },
        ]}
      >
        <a href={item.href}>{item.label}</a>
        {item.children && (
          <ul class="site-nav__dropdown">
            {item.children.map((child) => (
              <li><a href={child.href}>{child.label}</a></li>
            ))}
          </ul>
        )}
      </li>
    ))}
  </ul>
</nav>

<style>
  .site-nav > ul {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-md);
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .site-nav__item {
    position: relative;
  }
  .site-nav__item > a {
    display: inline-block;
    padding-block: 0.4rem;
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--text-on-dark);
    border-bottom: 2px solid transparent;
  }
  .site-nav__item > a:hover {
    border-color: var(--color-red);
  }
  .site-nav__item.has-children > a::after {
    content: "";
    display: inline-block;
    margin-left: 0.4rem;
    border: 4px solid transparent;
    border-top-color: currentColor;
    vertical-align: middle;
  }

  .site-nav__dropdown {
    position: absolute;
    top: 100%;
    left: 0;
    min-width: 13rem;
    margin: 0;
    padding: 0.5rem 0;
    list-style: none;
    background: var(--bg-dark-surface);
    border: 1px solid var(--border-on-dark);
    opacity: 0;
    visibility: hidden;
    transform: translateY(-4px);
    transition: opacity 0.12s ease, transform 0.12s ease;
    z-index: 20;
  }
  .site-nav__item.has-children:hover .site-nav__dropdown,
  .site-nav__item.has-children:focus-within .site-nav__dropdown {
    opacity: 1;
    visibility: visible;
    transform: translateY(0);
  }
  .site-nav__dropdown a {
    display: block;
    padding: 0.55rem 1rem;
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.02em;
    text-transform: none;
    color: var(--text-on-dark);
  }
  .site-nav__dropdown a:hover {
    background: var(--bg-dark);
    color: var(--color-red);
  }

  /* --- Menu mobile ---
     Non una lista di link ma una griglia 2x2 di riquadri rossi (Palestra,
     Discipline, Orari Corsi, Abbonamenti): bersagli grandi da toccare col
     pollice, con i sotto-link elencati dentro il riquadro del rispettivo
     gruppo. Le voci marcate `standalone` (Blog) restano fuori dalla
     griglia, in una fascia nera a piena larghezza sotto. */
  @media (max-width: 900px) {
    .site-nav > ul {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: var(--space-2xs);
      padding-block: var(--space-2xs) var(--space-sm);
    }
    .site-nav__item {
      display: flex;
      flex-direction: column;
      background: var(--accent);
      border: 2px solid var(--color-black);
      border-radius: 12px;
      padding: var(--space-sm);
    }
    .site-nav__item > a {
      padding-block: 0;
      font-family: var(--font-display);
      font-size: 1.15rem;
      font-weight: 400;
      letter-spacing: -0.01em;
      line-height: 1;
      color: var(--color-white);
      border-bottom: none;
    }
    /* La freccetta del dropdown non serve: i figli sono già visibili. */
    .site-nav__item.has-children > a::after {
      display: none;
    }
    .site-nav__dropdown {
      position: static;
      display: flex;
      flex-direction: column;
      opacity: 1;
      visibility: visible;
      transform: none;
      background: transparent;
      border: none;
      min-width: 0;
      margin-top: var(--space-2xs);
      padding: 0;
    }
    .site-nav__dropdown a {
      padding: 0.2rem 0;
      font-size: 0.78rem;
      color: var(--color-white);
      opacity: 0.85;
    }
    .site-nav__dropdown a:hover {
      background: transparent;
      color: var(--color-black);
      opacity: 1;
    }
    /* Fascia a se': fondo nero come il pannello, quindi il bordo nero
       sparirebbe. Bordo rosso per farla leggere come area toccabile. */
    .site-nav__item--standalone {
      grid-column: 1 / -1;
      align-items: center;
      background: var(--color-black);
      border-color: var(--color-red);
    }
  }
</style>
