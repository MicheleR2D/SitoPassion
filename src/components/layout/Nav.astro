---
import { NAV_ITEMS } from '../../data/nav.ts';
---

<nav class="site-nav">
  <ul>
    {NAV_ITEMS.map((item) => (
      <li
        class:list={[
          "site-nav__item",
          { "has-children": item.children, "site-nav__item--standalone": item.standalone },
        ]}
      >
        {/* .site-nav__card serve solo al menu mobile, dove e' il piano che
            ruota: su desktop e' display:contents, quindi il layout della
            barra e del dropdown resta esattamente quello di prima. */}
        <div class="site-nav__card">
          {/* Sempre un link vero, anche per le voci con sotto-pagine: il
              dropdown (desktop, via :hover/:focus-within) e le pastiglie
              (mobile) sono scorciatoie in piu', non l'unico modo per
              arrivarci — il titolo stesso porta alla sua pagina. */}
          <a class="site-nav__title" href={item.href}>
            {item.label}
            {item.tagline && <span class="site-nav__tagline">{item.tagline}</span>}
          </a>
          {item.children && (
            <ul class="site-nav__dropdown">
              {/* Ripete l'invito del fronte anche sul retro: girata la card,
                  il titolo non si vede piu' e resterebbe solo un elenco di
                  nomi senza contesto. <li> e non <p> per non infilare un
                  elemento non ammesso dentro la <ul>. */}
              {item.tagline && <li class="site-nav__dropdown-title">{item.tagline}</li>}
              {item.children.map((child) => (
                <li><a href={child.href}>{child.label}</a></li>
              ))}
            </ul>
          )}
        </div>
      </li>
    ))}
  </ul>
</nav>

<style>
  /* Su desktop il wrapper non esiste ai fini del layout: figli promossi. */
  .site-nav__card {
    display: contents;
  }

  .site-nav > ul {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-md);
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .site-nav__item {
    position: relative;
  }
  .site-nav__title {
    display: inline-block;
    appearance: none;
    background: none;
    border: none;
    border-bottom: 2px solid transparent;
    padding-inline: 0;
    padding-block: 0.4rem;
    font-family: inherit;
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--text-on-dark);
    cursor: pointer;
  }
  .site-nav__title:hover {
    border-color: var(--color-red);
  }
  .site-nav__item.has-children .site-nav__title::after {
    content: "";
    display: inline-block;
    margin-left: 0.4rem;
    border: 4px solid transparent;
    border-top-color: currentColor;
    vertical-align: middle;
  }
  /* Le righe d'invito servono solo ai riquadri del menu mobile. */
  .site-nav__tagline,
  .site-nav__dropdown-title {
    display: none;
  }

  .site-nav__dropdown {
    position: absolute;
    top: 100%;
    left: 0;
    min-width: 13rem;
    margin: 0;
    padding: 0.5rem 0;
    list-style: none;
    background: var(--bg-dark-surface);
    border: 1px solid var(--border-on-dark);
    opacity: 0;
    visibility: hidden;
    /* Leggermente piu' di corsa (era -4px/120ms, quasi uno scatto) e la
       stessa curva delle altre rivelazioni del sito, per una discesa che si
       vede invece di un cambio istantaneo. */
    transform: translateY(-8px);
    transition: opacity 0.25s ease, transform 0.3s cubic-bezier(0.22, 0.61, 0.36, 1),
      visibility 0.25s;
    z-index: 20;
  }
  .site-nav__item.has-children:hover .site-nav__dropdown,
  .site-nav__item.has-children:focus-within .site-nav__dropdown {
    opacity: 1;
    visibility: visible;
    transform: translateY(0);
  }
  .site-nav__dropdown a {
    display: block;
    padding: 0.55rem 1rem;
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.02em;
    text-transform: none;
    color: var(--text-on-dark);
    transition: background-color 0.15s ease, color 0.15s ease;
  }
  .site-nav__dropdown a:hover {
    background: var(--bg-dark);
    color: var(--color-red);
  }
  @media (prefers-reduced-motion: reduce) {
    .site-nav__dropdown {
      transition: opacity 0.12s ease, visibility 0.12s;
      transform: none;
    }
  }

  /* --- Menu mobile ---
     Un elenco per gruppi, tutto a vista. Prima era una griglia 2x2 di
     riquadri rossi che si **giravano** in hover per rivelare sul retro le
     sotto-pagine: su un telefono l'hover non esiste, il giro partiva col
     focus al tocco, e quindi per sapere cosa c'era sotto «Palestra»
     bisognava toccarla e scoprirlo. Quattro quinti del menu erano nascosti
     dietro un gesto che nessuno sapeva di dover fare.

     Adesso non c'e' niente da scoprire: ogni gruppo mostra il suo nome e
     sotto tutte le sue voci, come pastiglie affiancate. Si scorre, e con
     l'occhio si vede l'intero menu in due schermate invece di dover
     interagire per vederlo. */
  /* + totem: vedi «Il totem verticale del club» in styles/global.css */
  @media (max-width: 900px),
    (min-width: 900px) and (min-height: 1200px) and (max-aspect-ratio: 7/10) {
    /* Niente `height: 100%`: l'elenco e' alto quanto il suo contenuto e il
       pannello dell'header lo fa scorrere. Prima serviva perche' la griglia
       doveva spartirsi la schermata in due righe uguali. */
    .site-nav > ul {
      display: flex;
      flex-direction: column;
      gap: 0;
      padding: 0;
    }

    /* Un filetto fra i gruppi invece di riquadri con un bordo per lato: a
       schermo il primo si legge come una lista, il secondo come una
       scacchiera in cui ogni cosa ha lo stesso peso. */
    .site-nav__item {
      border-top: 1px solid var(--border-on-dark);
      padding: var(--space-sm) var(--container-gutter);
    }
    .site-nav__item:first-child {
      border-top: none;
    }

    .site-nav__card {
      display: block;
      position: static;
      inset: auto;
      /* Via la prospettiva e la transizione: non c'e' piu' niente che gira. */
      transform: none;
      transition: none;
    }

    /* Il nome del gruppo: e' un link vero anche qui, porta alla pagina del
       gruppo (es. "Palestra" -> /palestra/). Le pastiglie sotto restano
       scorciatoie dirette alle sotto-pagine, non l'unico modo di navigare. */
    .site-nav__title {
      position: static;
      inset: auto;
      display: block;
      width: 100%;
      text-align: left;
      padding: 0;
      font-family: var(--font-display);
      font-size: 1.5rem;
      font-weight: 400;
      letter-spacing: -0.01em;
      line-height: 1;
      text-transform: uppercase;
      color: var(--color-white);
      border-bottom: none;
      backface-visibility: visible;
    }
    /* La freccetta del dropdown: qui non c'e' nessun dropdown da aprire. */
    .site-nav__item.has-children .site-nav__title::after {
      display: none;
    }

    .site-nav__tagline {
      display: block;
      margin-top: 0.35rem;
      font-family: var(--font-body);
      font-size: 0.72rem;
      font-weight: 600;
      letter-spacing: 0.04em;
      text-transform: uppercase;
      line-height: 1.25;
      color: var(--text-on-dark-muted);
    }

    /* Le sotto-pagine: pastiglie affiancate che vanno a capo da sole. In
       colonna sarebbero diciotto righe identiche e il menu diventerebbe tre
       schermate; affiancate ne bastano due, e ogni pastiglia resta un
       bersaglio da pollice — 44px di altezza minima, che e' la misura sotto
       la quale si sbaglia link. */
    .site-nav__dropdown {
      position: static;
      inset: auto;
      display: flex;
      flex-direction: row;
      flex-wrap: wrap;
      gap: 0.5rem;
      min-width: 0;
      margin: var(--space-xs) 0 0;
      padding: 0;
      background: none;
      border: none;
      opacity: 1;
      visibility: visible;
      transform: none;
      backface-visibility: visible;
    }
    .site-nav__dropdown a {
      display: flex;
      align-items: center;
      min-height: 2.75rem;
      padding: 0.5rem 1rem;
      font-family: var(--font-body);
      font-size: 0.85rem;
      font-weight: 700;
      letter-spacing: 0.04em;
      text-transform: uppercase;
      line-height: 1.2;
      color: var(--color-white);
      background: transparent;
      border: 2px solid var(--accent);
      border-radius: 10px;
    }
    .site-nav__dropdown a:hover,
    .site-nav__dropdown a:active {
      background: var(--accent);
      color: var(--color-white);
    }
    /* L'invito serviva sul retro della card, dove il titolo non si vedeva
       piu'. Ora titolo e voci sono nella stessa schermata e ripeterlo
       sarebbe la stessa frase due volte a due centimetri di distanza. */
    .site-nav .site-nav__dropdown-title {
      display: none;
    }

    /* Le voci senza sotto-pagine (Blog) sono il titolo stesso, e quello e'
       un link: qui torna a essere un bersaglio, non solo un'intestazione. */
    .site-nav__item--standalone .site-nav__title {
      color: var(--accent);
    }
  }
</style>
