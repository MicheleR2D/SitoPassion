---
import { NAV_ITEMS } from '../../data/nav.ts';
---

<nav class="site-nav">
  <ul>
    {NAV_ITEMS.map((item) => (
      <li
        class:list={[
          "site-nav__item",
          { "has-children": item.children, "site-nav__item--standalone": item.standalone },
        ]}
      >
        {/* .site-nav__card serve solo al menu mobile, dove e' il piano che
            ruota: su desktop e' display:contents, quindi il layout della
            barra e del dropdown resta esattamente quello di prima. */}
        <div class="site-nav__card">
          {item.children ? (
            /* Le voci con sotto-pagine non portano da nessuna parte: il
               titolo apre il dropdown (desktop) o gira la card (mobile).
               <button> e non <span> perche' e' focalizzabile: al tocco
               riceve il focus e :focus-within fa scattare il giro. */
            <button class="site-nav__title" type="button">{item.label}</button>
          ) : (
            <a class="site-nav__title" href={item.href}>{item.label}</a>
          )}
          {item.children && (
            <ul class="site-nav__dropdown">
              {item.children.map((child) => (
                <li><a href={child.href}>{child.label}</a></li>
              ))}
            </ul>
          )}
        </div>
      </li>
    ))}
  </ul>
</nav>

<style>
  /* Su desktop il wrapper non esiste ai fini del layout: figli promossi. */
  .site-nav__card {
    display: contents;
  }

  .site-nav > ul {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-md);
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .site-nav__item {
    position: relative;
  }
  /* Il titolo e' un <a> (voci senza figli) o un <button> (voci con figli):
     qui si azzera lo stile nativo del bottone, cosi' i due sono identici. */
  .site-nav__title {
    display: inline-block;
    appearance: none;
    background: none;
    border: none;
    border-bottom: 2px solid transparent;
    padding-inline: 0;
    padding-block: 0.4rem;
    font-family: inherit;
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--text-on-dark);
    cursor: pointer;
  }
  .site-nav__title:hover {
    border-color: var(--color-red);
  }
  .site-nav__item.has-children .site-nav__title::after {
    content: "";
    display: inline-block;
    margin-left: 0.4rem;
    border: 4px solid transparent;
    border-top-color: currentColor;
    vertical-align: middle;
  }

  .site-nav__dropdown {
    position: absolute;
    top: 100%;
    left: 0;
    min-width: 13rem;
    margin: 0;
    padding: 0.5rem 0;
    list-style: none;
    background: var(--bg-dark-surface);
    border: 1px solid var(--border-on-dark);
    opacity: 0;
    visibility: hidden;
    transform: translateY(-4px);
    transition: opacity 0.12s ease, transform 0.12s ease;
    z-index: 20;
  }
  .site-nav__item.has-children:hover .site-nav__dropdown,
  .site-nav__item.has-children:focus-within .site-nav__dropdown {
    opacity: 1;
    visibility: visible;
    transform: translateY(0);
  }
  .site-nav__dropdown a {
    display: block;
    padding: 0.55rem 1rem;
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.02em;
    text-transform: none;
    color: var(--text-on-dark);
  }
  .site-nav__dropdown a:hover {
    background: var(--bg-dark);
    color: var(--color-red);
  }

  /* --- Menu mobile ---
     Non una lista di link ma una griglia 2x2 di riquadri rossi (Palestra,
     Discipline, Orari Corsi, Abbonamenti): bersagli grandi da toccare col
     pollice. I riquadri con sotto-pagine mostrano solo il titolo e si
     girano in hover, rivelando sul retro i nomi delle pagine. Le voci
     marcate `standalone` (Blog) restano fuori dalla griglia, in una fascia
     nera a piena larghezza sotto. */
  @media (max-width: 900px) {
    /* Il menu riempie la schermata: il pannello ha un'altezza definita
       (vedi Header) e qui la griglia la eredita, cosi' le due righe di
       riquadri si dividono lo spazio disponibile. */
    .site-nav {
      height: 100%;
    }
    .site-nav > ul {
      display: grid;
      grid-template-columns: 1fr 1fr;
      /* Due righe di riquadri che si spartiscono l'altezza + la fascia
         finale (Blog) alta quanto il suo contenuto. */
      grid-template-rows: 1fr 1fr auto;
      gap: 2px;
      height: 100%;
      padding: 2px 0 0;
    }
    /* Il riquadro e' il contenitore della prospettiva: il piano che ruota
       e' .site-nav__card al suo interno. */
    .site-nav__item {
      position: relative;
      border: 2px solid var(--color-black);
      background: var(--accent);
      perspective: 60rem;
    }
    .site-nav__card {
      display: block;
      position: absolute;
      inset: 0;
      transform-style: preserve-3d;
      transition: transform 0.55s cubic-bezier(0.22, 0.61, 0.36, 1);
    }
    /* Le due facce occupano lo stesso spazio, contenuto centrato; il retro
       parte girato di 180deg, cosi' ruotando la card diventa fronte. */
    .site-nav__title,
    .site-nav__dropdown {
      position: absolute;
      inset: 0;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      text-align: center;
      gap: var(--space-2xs);
      padding: var(--space-sm);
      backface-visibility: hidden;
    }
    .site-nav__title {
      padding-block: var(--space-sm);
      font-family: var(--font-display);
      font-size: clamp(1.5rem, 7vw, 2.2rem);
      font-weight: 400;
      letter-spacing: -0.01em;
      line-height: 1;
      color: var(--color-white);
      border-bottom: none;
    }
    /* La freccetta del dropdown non serve: il retro si rivela girando. */
    .site-nav__item.has-children .site-nav__title::after {
      display: none;
    }
    /* Retro: inversione dei colori del fronte (rosso su bianco), cosi' i
       nomi in rosso richiesti restano leggibili. */
    .site-nav__dropdown {
      opacity: 1;
      visibility: visible;
      min-width: 0;
      margin: 0;
      background: var(--color-white);
      border: none;
      transform: rotateY(180deg);
    }
    .site-nav__dropdown a {
      padding: 0.15rem 0;
      font-family: var(--font-display);
      text-transform: uppercase;
      font-size: clamp(1.05rem, 4.4vw, 1.4rem);
      line-height: 1.1;
      color: var(--color-red);
    }
    .site-nav__dropdown a:hover {
      background: transparent;
      color: var(--color-black);
    }
    /* Il giro: hover col mouse, focus-within da tastiera/tap. */
    .site-nav__item.has-children:hover .site-nav__card,
    .site-nav__item.has-children:focus-within .site-nav__card {
      transform: rotateY(180deg);
    }
    /* Il retro deve restare girato di 180deg anche in hover: la regola
       desktop del dropdown (translateY(0), piu' specifica di una classe
       sola) altrimenti vince e lo raddrizza, e con backface-visibility
       nascosta il retro non si vedrebbe mai - si vedrebbe solo il rosso
       del riquadro sotto. */
    .site-nav__item.has-children:hover .site-nav__dropdown,
    .site-nav__item.has-children:focus-within .site-nav__dropdown {
      transform: rotateY(180deg);
    }
    @media (prefers-reduced-motion: reduce) {
      .site-nav__card {
        transition: none;
      }
    }
    /* Fascia a se': fondo nero come il pannello, quindi il bordo nero
       sparirebbe. Bordo rosso per farla leggere come area toccabile. */
    .site-nav__item--standalone {
      grid-column: 1 / -1;
      background: var(--color-black);
      border-color: var(--color-red);
    }
    /* La fascia Blog e' alta quanto il suo contenuto (riga `auto` della
       griglia): con la faccia in position:absolute non avrebbe altezza, qui
       torna nel flusso (non deve girarsi, non ha sotto-pagine). */
    .site-nav__item--standalone .site-nav__card,
    .site-nav__item--standalone .site-nav__title {
      position: static;
      inset: auto;
    }
  }
</style>
